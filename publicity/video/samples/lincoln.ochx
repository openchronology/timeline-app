 "events": [
  {
   "id": "h-frontier",
   "time": "-5080647600/1",
   "metadata": {
    "title": "Kentucky and Indiana",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "born",
   "time": "-5077018800/1",
   "metadata": {
    "title": "Born in Kentucky",
    "description": "Abraham Lincoln is born in a one-room log cabin on **Sinking Spring Farm**, near Hodgenville, Kentucky, to **Thomas Lincoln** and **Nancy Hanks Lincoln**. His sister **Sarah** is two years older.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Abraham_Lincoln",
     "https://www.nps.gov/abli/index.htm"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "knob-creek",
   "time": "-5001937200/1",
   "metadata": {
    "title": "Move to Knob Creek",
    "description": "The family moves about ten miles to a farm on **Knob Creek**, the earliest home Lincoln later remembered.",
    "tags": [
     "home"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.nps.gov/abli/index.htm"
    ],
    "color": "#8a7a5c",
    "datePrecision": "Summer 1811; the month and day are not recorded."
   }
  },
  {
   "id": "tommy",
   "time": "-4970314800/1",
   "metadata": {
    "title": "A brother, Thomas, dies in infancy",
    "description": "Lincoln's younger brother **Thomas** lives only a few days and is buried near Knob Creek.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#4f7a4a",
    "datePrecision": "Born in 1812 or 1813 and lived only a few days; placed in 1812."
   }
  },
  {
   "id": "to-indiana",
   "time": "-4830865200/1",
   "metadata": {
    "title": "Move to Indiana",
    "description": "Partly over land-title disputes and partly, Lincoln later said, because of slavery, Thomas Lincoln moves the family across the Ohio River to **Little Pigeon Creek**, in what became Spencer County, Indiana.",
    "tags": [
     "home"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.nps.gov/libo/index.htm"
    ],
    "color": "#8a7a5c",
    "datePrecision": "December 1816; the day is not recorded."
   }
  },
  {
   "id": "nancy-dies",
   "time": "-4772718000/1",
   "metadata": {
    "title": "His mother dies",
    "description": "**Nancy Hanks Lincoln** dies of milk sickness, poisoning from the milk of cows that had grazed on white snakeroot. Abraham is nine.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Nancy_Lincoln"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "stepmother",
   "time": "-4736170800/1",
   "metadata": {
    "title": "A stepmother, Sarah Bush Johnston",
    "description": "Thomas Lincoln marries the widow **Sarah Bush Johnston** in Elizabethtown, Kentucky. She brings her three children to Indiana and encourages Abraham’s reading; he remained devoted to her.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Sarah_Bush_Lincoln"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "sarah-dies",
   "time": "-4479476400/1",
   "metadata": {
    "title": "His sister Sarah dies",
    "description": "**Sarah Lincoln Grigsby** dies in childbirth, aged twenty, a year and a half after marrying Aaron Grigsby.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lincoln_family"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "flatboat-1828",
   "time": "-4473255600/1",
   "metadata": {
    "title": "Flatboat to New Orleans",
    "description": "With **Allen Gentry**, Lincoln takes a flatboat of produce down the Ohio and Mississippi to **New Orleans**, his first sight of a great city.",
    "tags": [
     "work"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#7a5c2e",
    "datePrecision": "Spring 1828; placed in April."
   }
  },
  {
   "id": "to-illinois",
   "time": "-4412862000/1",
   "metadata": {
    "title": "The family moves to Illinois",
    "description": "The Lincolns and their relatives leave Indiana for **Macon County, Illinois**, near Decatur. Abraham, just twenty-one, helps clear and fence the new farm.",
    "tags": [
     "home"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#8a7a5c",
    "datePrecision": "They set out in early March 1830."
   }
  },
  {
   "id": "flatboat-1831",
   "time": "-4376055600/1",
   "metadata": {
    "title": "Second flatboat trip",
    "description": "Lincoln, his stepbrother **John D. Johnston** and cousin **John Hanks** take a flatboat to New Orleans for the trader **Denton Offutt**, who then hires him to clerk a store in New Salem.",
    "tags": [
     "work"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#7a5c2e",
    "datePrecision": "Left in late April or early May 1831."
   }
  },
  {
   "id": "h-new-salem",
   "time": "-4370785200/1",
   "metadata": {
    "title": "New Salem",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "new-salem",
   "time": "-4368711600/1",
   "metadata": {
    "title": "Arrives in New Salem",
    "description": "Lincoln settles in **New Salem**, a village on the Sangamon River, on his own for the first time: a clerk, a wrestler, a reader of borrowed books.",
    "tags": [
     "home"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#8a7a5c",
    "datePrecision": "Late July 1831; the day is not recorded."
   }
  },
  {
   "id": "candidacy",
   "time": "-4349012400/1",
   "metadata": {
    "title": "First run for the legislature",
    "description": "His first public letter, to the people of **Sangamon County** in the Sangamo Journal, announces his candidacy for the Illinois House and argues for river improvements and education.",
    "tags": [
     "politics",
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://quod.lib.umich.edu/l/lincoln/"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "captain",
   "time": "-4345297200/1",
   "metadata": {
    "title": "Elected captain of volunteers",
    "description": "Volunteering for the **Black Hawk War**, Lincoln is elected captain by his company, an honor he later said gave him more pleasure than any since. He saw no combat.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Abraham_Lincoln_in_the_Black_Hawk_War",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "loses-1832",
   "time": "-4336052400/1",
   "metadata": {
    "title": "Loses his first election",
    "description": "Back from the war with little time to campaign, he finishes eighth of thirteen for four seats, though New Salem gives him 277 of its 300 votes.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "store",
   "time": "-4322055600/1",
   "metadata": {
    "title": "A store with William Berry",
    "description": "Lincoln and **William F. Berry** buy a New Salem store on credit. It fails, and after Berry’s death Lincoln spends years repaying what he called \"the national debt\".",
    "tags": [
     "work"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#7a5c2e",
    "datePrecision": "Bought late in 1832 or early in 1833; placed in January 1833."
   }
  },
  {
   "id": "postmaster",
   "time": "-4312378800/1",
   "metadata": {
    "title": "Appointed postmaster",
    "description": "He becomes postmaster of **New Salem**, a small federal post that let him read every newspaper that came through.",
    "tags": [
     "office"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "surveyor",
   "time": "-4294407600/1",
   "metadata": {
    "title": "Deputy surveyor",
    "description": "Taught by borrowed books, he becomes a deputy to **John Calhoun**, the Sangamon County surveyor, laying out roads, farms and town lots until early 1836.",
    "tags": [
     "work"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#7a5c2e",
    "datePrecision": "Late 1833 or the first days of 1834; placed in December 1833."
   }
  },
  {
   "id": "elected-1834",
   "time": "-4273153200/1",
   "metadata": {
    "title": "Elected to the Illinois House",
    "description": "At twenty-five, Lincoln wins a seat for **Sangamon County**, the first of four straight terms as a Whig. **John Todd Stuart** urges him to study law.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "ann-rutledge",
   "time": "-4239802800/1",
   "metadata": {
    "title": "Ann Rutledge dies",
    "description": "**Ann Rutledge**, a New Salem friend, dies of what was probably typhoid. Her death grieved him deeply; how close they were is debated by historians.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Ann_Rutledge"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "reelected-1836",
   "time": "-4210254000/1",
   "metadata": {
    "title": "Re-elected with the Long Nine",
    "description": "He tops the poll in Sangamon County, one of nine unusually tall Whigs from the county, the **Long Nine**.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "license",
   "time": "-4206884400/1",
   "metadata": {
    "title": "Licensed to practice law",
    "description": "Self-taught from borrowed books, chiefly **Blackstone’s Commentaries**, Lincoln receives his license to practice law in Illinois.",
    "tags": [
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#7a5c2e"
   }
  },
  {
   "id": "capital",
   "time": "-4192023600/1",
   "metadata": {
    "title": "The capital moves to Springfield",
    "description": "The legislature votes to move the state capital from Vandalia to **Springfield**, a measure Lincoln and the Long Nine worked hard for.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "protest",
   "time": "-4191764400/1",
   "metadata": {
    "title": "Lincoln–Stone protest",
    "description": "With **Dan Stone**, Lincoln enters a protest in the House journal: slavery is \"founded on both injustice and bad policy\", though Congress has no power to interfere with it in the states. Only six members had voted against resolutions condemning abolitionists.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln",
     "https://quod.lib.umich.edu/l/lincoln/"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "h-springfield",
   "time": "-4189258800/1",
   "metadata": {
    "title": "Springfield",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "to-springfield",
   "time": "-4188049200/1",
   "metadata": {
    "title": "Moves to Springfield",
    "description": "Lincoln rides into **Springfield** with everything he owns in two saddlebags, shares a room above **Joshua Speed**’s store, and becomes **John Todd Stuart**’s law partner.",
    "tags": [
     "home",
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Joshua_Fry_Speed",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#8a7a5c"
   }
  },
  {
   "id": "lyceum",
   "time": "-4163252400/1",
   "metadata": {
    "title": "Lyceum Address",
    "description": "To the Young Men’s Lyceum of Springfield, Lincoln warns that the danger to the republic is from within: mob violence and disregard for law.",
    "tags": [
     "speech"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Abraham_Lincoln's_Lyceum_address",
     "https://quod.lib.umich.edu/l/lincoln/"
    ],
    "color": "#5b4a8a"
   }
  },
  {
   "id": "broken",
   "time": "-4070804400/1",
   "metadata": {
    "title": "Engagement to Mary Todd broken",
    "description": "Lincoln breaks off his engagement to **Mary Todd** and falls into a deep depression. They reconcile in 1842.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Mary_Todd_Lincoln",
     "https://en.wikipedia.org/wiki/Early_life_and_career_of_Abraham_Lincoln"
    ],
    "color": "#4f7a4a",
    "datePrecision": "The \"fatal first of January\" 1841; what happened that day is not fully known."
   }
  },
  {
   "id": "shields",
   "time": "-4016458800/1",
   "metadata": {
    "title": "A duel called off",
    "description": "Satirical letters by Lincoln (and, it seems, Mary Todd) provoke the Democrat **James Shields** to challenge him. On Bloody Island, opposite Alton, friends settle it before a blow is struck.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/James_Shields",
     "https://en.wikipedia.org/wiki/Mary_Todd_Lincoln"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "marriage",
   "time": "-4012743600/1",
   "metadata": {
    "title": "Marries Mary Todd",
    "description": "Lincoln marries **Mary Ann Todd**, of a prominent Lexington, Kentucky family, at her sister’s home in Springfield. They board at the **Globe Tavern**.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Mary_Todd_Lincoln",
     "https://www.thelincolnlog.org/"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "robert-born",
   "time": "-3989415600/1",
   "metadata": {
    "title": "Robert is born",
    "description": "**Robert Todd Lincoln**, their first son and the only one to grow to adulthood. He became Secretary of War and died in 1926.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Robert_Todd_Lincoln"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "house",
   "time": "-3965742000/1",
   "metadata": {
    "title": "The house at Eighth and Jackson",
    "description": "The Lincolns buy a one-and-a-half-storey house at **Eighth and Jackson** streets, the only home Lincoln ever owned; it is now the Lincoln Home National Historic Site.",
    "tags": [
     "home",
     "family"
    ],
