{
 "format": "openchronology",
 "version": 1,
 "title": "Middle-earth: an unofficial chronology",
 "description": "The legendarium from the Years of the Trees to the Fourth Age, in each Age's own reckoning (F.A., S.A., T.A., Fo.A.). Each event is tagged by the book that tells it; First Age years come from Tolkien's later annals, and the War of the Ring keeps its Shire Reckoning dates.\n\nAn unofficial fan chronology for a video about keeping a canon. Not affiliated with or endorsed by the Tolkien Estate or its licensees; summaries are our own.",
 "presentation": {
  "ruler": {
   "kind": "steps",
   "steps": [
    "2629800",
    "31557600",
    "157788000",
    "315576000",
    "1577880000",
    "3155760000",
    "15778800000",
    "31557600000"
   ]
  },
  "mode": "custom",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6,
  "source": "function print(time: Rational, api: TimeAPI): string {\n  const x = api.div(time, api.rational(\"31557600\"));\n  const fine = api.hasView() ? api.compare(api.labelResolution(), api.rational(\"31557600\")) < 0 : true;\n  const age = api.compare(x, api.rational(\"591\")) < 0 ? \"F.A. \" : api.compare(x, api.rational(\"4032\")) < 0 ? \"S.A. \" : api.compare(x, api.rational(\"7053\")) < 0 ? \"T.A. \" : \"Fo.A. \";\n  const base = api.compare(x, api.rational(\"591\")) < 0 ? api.rational(\"0\") : api.compare(x, api.rational(\"4032\")) < 0 ? api.rational(\"590\") : api.compare(x, api.rational(\"7053\")) < 0 ? api.rational(\"4031\") : api.rational(\"7052\");\n  const y = api.sub(x, base);\n  return api.compare(x, api.rational(\"1\")) < 0 ? \"Years of the Trees\" : age + (fine ? api.decimal(y, 2) : api.decimal(api.sub(y, api.rational(\"1/2\")), 0));\n}\nfunction parse(text: string, api: TimeAPI): Rational {\n  const t = api.trim(text);\n  const years = api.startsWith(t, \"Fo.A. \") ? api.add(api.rational(\"7052\"), api.parseNumber(api.slice(t, 6))) : api.startsWith(t, \"T.A. \") ? api.add(api.rational(\"4031\"), api.parseNumber(api.slice(t, 5))) : api.startsWith(t, \"S.A. \") ? api.add(api.rational(\"590\"), api.parseNumber(api.slice(t, 5))) : api.startsWith(t, \"F.A. \") ? api.parseNumber(api.slice(t, 5)) : api.rational(\"0\");\n  return api.mul(years, api.rational(\"31557600\"));\n}"
 },
 "tags": [
  "fiction",
  "canon",
  "tolkien",
  "chronology"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "historical-dates",
    "version": 1,
    "name": "Historical dates",
    "description": "Retain an original historical date and its calendar separately from the timeline coordinate and display calendar, such as a Julian date on a Gregorian timeline.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "historicalDate",
      "label": "Original historical date"
     },
     {
      "kind": "text",
      "metadataKey": "calendar",
      "label": "Original calendar"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 1,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors and fonts: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#ece4c8",
    "textFont": "Georgia, serif",
    "measureColor": "#c9a54a",
    "haloColor": "#10201a",
    "markerColor": "#c9a54a",
    "durationColor": "#3d5a48",
    "backgroundColor": "#10201a"
   }
  }
 ],
