 "durations": [
  {
   "id": "trees",
   "start": "-315574895484/25",
   "end": "790044516/25",
   "metadata": {
    "title": "The Years of the Trees",
    "description": "Before the Sun. Tolkien reckoned these Valian Years differently in different drafts, so this span is a placeholder, not a length.",
    "tags": [
     "age"
