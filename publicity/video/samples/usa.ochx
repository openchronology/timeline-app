{
 "format": "openchronology",
 "version": 1,
 "title": "The United States, 1775–2008",
 "description": "From the first shots of the Revolution to the twenty-first century: wars, amendments, discoveries and the movements that changed who the rights in the founding documents applied to.\n\n**How to read it.** Chapter headings mark the eras. Wars and movements are durations; everything else is a moment, linked to the Wikipedia article it draws on. Related events (an amendment and the one it led to) are linked. Dates are in UTC.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "history",
  "united states",
  "education"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-sources",
    "version": 1,
    "name": "Sources",
    "description": "Show and edit a series of source links for moments and stack entries.",
    "fields": [
     {
      "kind": "links",
      "metadataKey": "sources",
      "label": "Sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 1,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors and fonts: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#1f2a44",
    "textFont": "Georgia, serif",
    "measureColor": "#9c3b2a",
    "haloColor": "#f3ead7",
    "markerColor": "#1f3a5f",
    "durationColor": "#9c3b2a",
    "backgroundColor": "#f3ead7"
   }
  }
 ],
