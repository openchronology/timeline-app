 "events": [
  {
   "id": "h-emergence",
   "time": "1575158400/1",
   "metadata": {
    "title": "Emergence",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "onsets",
   "time": "1575763200/1",
   "metadata": {
    "title": "Earliest known cases fall ill",
    "description": "The earliest symptom onsets later identified in **Wuhan**, Hubei province. The first patients had pneumonia of unknown cause; many, not all, were linked to the **Huanan Seafood Wholesale Market**.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_mainland_China",
     "https://doi.org/10.1016/S0140-6736(20)30183-5",
     "https://www.who.int/publications/i/item/who-convened-global-study-of-origins-of-sars-cov-2-china-part"
    ],
    "datePrecision": "Early December 2019; reports differ. The WHO–China joint study (2021) gives 8 December as the earliest confirmed onset; Huang et al. (Lancet, 2020) reported one patient falling ill on 1 December."
   }
  },
  {
   "id": "li-warns",
   "time": "1577664000/1",
   "metadata": {
    "title": "Doctors warn colleagues",
    "description": "Wuhan’s health commission sends hospitals an urgent internal notice about pneumonia of unknown cause. The ophthalmologist **Li Wenliang** warns colleagues in a chat group, and is later reprimanded by police.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Li_Wenliang"
    ]
   }
  },
  {
   "id": "wuhan-cluster",
   "time": "1577750400/1",
   "metadata": {
    "title": "A cluster of pneumonia reported in Wuhan",
    "description": "The **Wuhan Municipal Health Commission** publicly reports a cluster of pneumonia cases of unknown cause, 27 of them. **WHO’s China country office** picks up its statement the same day.",
    "tags": [
     "who",
     "spread"
    ],
    "sources": [
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19",
     "https://en.wikipedia.org/wiki/COVID-19_pandemic"
    ],
    "color": "#b07a2a"
   }
  },
  {
   "id": "market-closed",
   "time": "1577836800/1",
   "metadata": {
    "title": "Huanan market closed",
    "description": "Wuhan closes the **Huanan Seafood Wholesale Market** for cleaning and disinfection.",
    "tags": [
     "measures"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Huanan_Seafood_Wholesale_Market"
    ]
   }
  },
  {
   "id": "who-imst",
   "time": "1577880000/1",
   "metadata": {
    "title": "WHO sets up an incident team",
    "description": "WHO sets up an **Incident Management Support Team** across its headquarters, regional and country levels.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19"
    ],
    "datePrecision": "1 January 2020; drawn at noon so it stands apart from the market’s closure the same day."
   }
  },
  {
   "id": "who-don",
   "time": "1578182400/1",
   "metadata": {
    "title": "WHO’s first outbreak news",
    "description": "WHO publishes its first **Disease Outbreak News** on the pneumonia of unknown cause in Wuhan, with a risk assessment and advice.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19"
    ]
   }
  },
  {
   "id": "novel-cov",
   "time": "1578528000/1",
   "metadata": {
    "title": "A new coronavirus identified",
    "description": "Chinese authorities report that the cause is a **novel coronavirus**; WHO says so in a statement the same day.",
    "tags": [
     "science",
     "who"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/SARS-CoV-2"
    ],
    "color": "#4f6f45"
   }
  },
  {
   "id": "genome",
   "time": "1578704700/1",
   "metadata": {
    "title": "The genome is published",
    "description": "The virus’s genome sequence, from **Zhang Yongzhen**’s team at Fudan University, is posted on **Virological.org** by **Edward Holmes**, for anyone to use. Vaccine and test developers start work from it.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://virological.org/t/novel-2019-coronavirus-genome/319",
     "https://doi.org/10.1038/s41586-020-2008-3",
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19"
    ],
    "color": "#4f6f45",
    "datePrecision": "Posted at 01:05 UTC on 11 January 2020 (10 January in the Americas). WHO’s timeline dates China’s public sharing of the sequence to 12 January."
   }
  },
  {
   "id": "first-death",
   "time": "1578744000/1",
   "metadata": {
    "title": "First reported death",
    "description": "Chinese authorities report the first death: a 61-year-old man in Wuhan.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_mainland_China"
    ],
    "datePrecision": "Reported 11 January 2020 (he died on 9 January); drawn at noon, apart from the genome’s publication."
   }
  },
  {
   "id": "thailand",
   "time": "1578873600/1",
   "metadata": {
    "title": "First case outside China",
    "description": "**Thailand** confirms a case in a traveller from Wuhan: the first recorded outside China.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19"
    ]
   }
  },
  {
   "id": "h2h",
   "time": "1579478400/1",
   "metadata": {
    "title": "Human-to-human spread confirmed",
    "description": "The epidemiologist **Zhong Nanshan**, for China’s National Health Commission, says on state television that the virus spreads between people.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Zhong_Nanshan"
    ]
   }
  },
  {
   "id": "us-first",
   "time": "1579564800/1",
   "metadata": {
    "title": "First US case",
    "description": "The **CDC** confirms the first case in the United States, in Washington State.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://www.cdc.gov/media/releases/2020/p0121-novel-coronavirus-travel-case.html",
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_the_United_States"
    ]
   }
  },
  {
   "id": "ec-first",
   "time": "1579651200/1",
   "metadata": {
    "title": "Emergency Committee first meets",
    "description": "WHO’s **Emergency Committee** under the International Health Regulations meets on 22–23 January and cannot reach consensus on declaring an emergency.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/news/item/27-04-2020-who-timeline---covid-19"
    ]
   }
  },
  {
   "id": "wuhan-lockdown",
   "time": "1579744800/1",
   "metadata": {
    "title": "Wuhan locked down",
    "description": "At 10 a.m. local time, Wuhan suspends public transport and closes outbound routes; other cities in Hubei follow within days.",
    "tags": [
     "measures"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_lockdown_in_China"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "europe-first",
   "time": "1579824000/1",
   "metadata": {
    "title": "First cases in Europe",
    "description": "**France** confirms three cases: the first in Europe.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_France"
    ]
   }
  },
  {
   "id": "huang",
   "time": "1579867200/1",
   "metadata": {
    "title": "First clinical report",
    "description": "**Huang et al.** describe the first 41 hospitalised patients in Wuhan in *The Lancet*: their symptoms, scans and outcomes.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://doi.org/10.1016/S0140-6736(20)30183-5"
    ],
    "color": "#4f6f45",
    "datePrecision": "Published online 24 January 2020; drawn at noon, apart from France’s cases."
   }
  },
  {
   "id": "pheic",
   "time": "1580342400/1",
   "metadata": {
    "title": "A public health emergency of international concern",
    "description": "After its Emergency Committee reaches consensus, WHO’s Director-General **Tedros Adhanom Ghebreyesus** declares the outbreak a **public health emergency of international concern** (PHEIC), WHO’s highest level of alarm under the International Health Regulations.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/news/item/30-01-2020-statement-on-the-second-meeting-of-the-international-health-regulations-(2005)-emergency-committee-regarding-the-outbreak-of-novel-coronavirus-(2019-ncov)",
     "https://en.wikipedia.org/wiki/Public_health_emergency_of_international_concern"
    ],
    "color": "#b07a2a"
   }
  },
  {
   "id": "first-death-outside",
   "time": "1580601600/1",
   "metadata": {
    "title": "First death outside China",
    "description": "The **Philippines** reports the first death outside mainland China.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_the_Philippines"
    ]
   }
  },
  {
   "id": "bat-relative",
   "time": "1580688000/1",
   "metadata": {
    "title": "A close relative in bats",
    "description": "*Nature* publishes two papers describing the new virus. **Zhou et al.** report a bat coronavirus whose genome is 96% identical to it; **Wu et al.** describe its genome.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://doi.org/10.1038/s41586-020-2012-7",
     "https://doi.org/10.1038/s41586-020-2008-3"
    ],
    "color": "#4f6f45"
   }
  },
  {
   "id": "li-dies",
   "time": "1581033600/1",
   "metadata": {
    "title": "Li Wenliang dies",
    "description": "The doctor **Li Wenliang**, who had warned colleagues in December, dies of COVID-19 in Wuhan.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Li_Wenliang"
    ]
   }
  },
  {
   "id": "name",
   "time": "1581379200/1",
   "metadata": {
    "title": "The disease is named COVID-19",
    "description": "WHO names the disease **COVID-19**: **co**rona**vi**rus **d**isease, 20**19**, a name chosen not to refer to a place, an animal or a group of people.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/emergencies/diseases/novel-coronavirus-2019/technical-guidance/naming-the-coronavirus-disease-(covid-2019)-and-the-virus-that-causes-it",
     "https://en.wikipedia.org/wiki/COVID-19"
    ]
   }
  },
  {
   "id": "ictv",
   "time": "1581422400/1",
   "metadata": {
    "title": "The virus is named SARS-CoV-2",
    "description": "The **International Committee on Taxonomy of Viruses** names the virus **SARS-CoV-2**, a sister of the 2003 SARS coronavirus.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://doi.org/10.1038/s41564-020-0695-z",
     "https://www.who.int/emergencies/diseases/novel-coronavirus-2019/technical-guidance/naming-the-coronavirus-disease-(covid-2019)-and-the-virus-that-causes-it"
    ],
    "color": "#4f6f45",
    "datePrecision": "11 February 2020, the same day as WHO’s name for the disease; drawn at noon."
   }
  },
  {
   "id": "africa-first",
   "time": "1581638400/1",
   "metadata": {
    "title": "First case in Africa",
    "description": "**Egypt** confirms the first case on the African continent.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_Africa"
    ]
   }
  },
  {
   "id": "codogno",
   "time": "1582243200/1",
   "metadata": {
    "title": "A cluster in Lombardy",
    "description": "A case confirmed in **Codogno**, Lombardy, reveals local spread in northern Italy; eleven towns in Lombardy and Veneto are quarantined two days later.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_Italy"
    ]
   }
  },
  {
   "id": "brazil-first",
   "time": "1582675200/1",
   "metadata": {
    "title": "First case in Latin America",
    "description": "**Brazil** confirms a case in São Paulo, the first in Latin America.",
    "tags": [
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_Brazil"
    ]
   }
  },
  {
   "id": "mission-report",
   "time": "1582848000/1",
   "metadata": {
    "title": "WHO–China joint mission reports",
    "description": "The **WHO–China Joint Mission** publishes its report on the outbreak in China, its spread and the measures taken.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/publications/i/item/report-of-the-who-china-joint-mission-on-coronavirus-disease-2019-(covid-19)"
    ]
   }
  },
  {
   "id": "h-pandemic",
   "time": "1583020800/1",
   "metadata": {
    "title": "A pandemic",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "pandemic",
   "time": "1583884800/1",
   "metadata": {
    "title": "WHO: a pandemic",
    "description": "WHO assesses that COVID-19 **can be characterized as a pandemic**. The Director-General cites more than 118,000 cases in 114 countries and 4,291 deaths.",
    "tags": [
     "who"
    ],
    "sources": [
     "https://www.who.int/news-room/speeches/item/who-director-general-s-opening-remarks-at-the-media-briefing-on-covid-19---11-march-2020",
     "https://en.wikipedia.org/wiki/COVID-19_pandemic"
    ],
    "color": "#b07a2a"
   }
  },
  {
   "id": "us-emergency",
   "time": "1584057600/1",
   "metadata": {
    "title": "US national emergency",
    "description": "President **Donald Trump** declares a national emergency under the National Emergencies Act.",
    "tags": [
     "measures"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_the_United_States"
    ]
   }
  },
  {
   "id": "europe-epicentre",
   "time": "1584100800/1",
   "metadata": {
    "title": "WHO: Europe the epicentre",
    "description": "WHO says Europe has become the epicentre of the pandemic.",
    "tags": [
     "who",
     "spread"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_Europe"
    ],
    "datePrecision": "13 March 2020; drawn at noon, apart from the US declaration."
   }
  },
  {
   "id": "first-vaccine-trial",
   "time": "1584316800/1",
   "metadata": {
    "title": "First vaccine trial dose",
    "description": "At **Kaiser Permanente Washington** in Seattle, the first volunteer receives **mRNA-1273**, the Moderna and NIH vaccine, in a phase 1 trial: the first COVID-19 vaccine trial to dose a person.",
    "tags": [
     "science",
     "vaccine"
    ],
    "sources": [
     "https://www.nih.gov/news-events/news-releases/nih-clinical-trial-investigational-vaccine-covid-19-begins",
     "https://en.wikipedia.org/wiki/Moderna_COVID-19_vaccine"
    ],
    "color": "#4f6f45"
   }
  },
  {
   "id": "eu-borders",
   "time": "1584403200/1",
   "metadata": {
    "title": "EU closes its external borders",
    "description": "EU leaders agree to restrict non-essential travel into the EU for 30 days; it is extended several times.",
    "tags": [
     "measures"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/COVID-19_pandemic_in_Europe"
    ]
   }
  },
  {
   "id": "solidarity",
   "time": "1584489600/1",
