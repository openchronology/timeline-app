{
 "format": "openchronology",
 "version": 1,
 "title": "The COVID-19 pandemic, 2019–2023",
 "description": "The COVID-19 pandemic worldwide, from the first reported cluster of pneumonia in Wuhan in December 2019 to the end of WHO’s public health emergency of international concern and of the US public health emergency in May 2023: WHO’s declarations, the spread, measures such as lockdowns, the science and the vaccines, the variants of concern and the waves they drove, and the counts. A sample timeline built from the sources cited on each moment: WHO statements and reports, regulators and public-health agencies, peer-reviewed papers, the Johns Hopkins CSSE and Our World in Data counts, and Wikipedia as the general reference.\n\n**How to read it.** Chapter headings mark the phases. Emergencies, lockdowns, waves and events are bands (ochre, navy, brick and grey); everything else is a moment. Green marks science and vaccines, brick the variants, grey the counts. Related things (a variant reported and its designation, an emergency declared and ended) are linked.\n\n**Dates and numbers.** Dates are UTC days unless a time is given. Counts are confirmed cases and deaths as reported, which understate the true numbers; WHO’s excess-mortality figure is an estimate and labelled so. Waves are approximate. The origin of the virus has not been established: it remains under investigation and is debated (see WHO’s SAGO reports). Measures are described with their dates, not judged.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "history",
  "public health",
  "covid-19",
  "education"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-sources",
    "version": 1,
    "name": "Sources",
    "description": "Show and edit a series of source links for moments and stack entries.",
    "fields": [
     {
      "kind": "links",
      "metadataKey": "sources",
      "label": "Sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 2,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors, fonts and text sizes: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
