   "metadata": {
    "tags": [
     "evacuation",
     "korean war",
     "chosin"
    ],
    "title": "The last ships leave Hungnam",
    "iconUrl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/USS_Begor_%28APD-127%29_off_Hungnam_on_24_December_1950_%2880-G-K-11769%29.jpg/960px-USS_Begor_%28APD-127%29_off_Hungnam_on_24_December_1950_%2880-G-K-11769%29.jpg",
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Chosin_Reservoir"
    ],
    "description": "The last UN units sailed from Hungnam on 24 December 1950, and the port was destroyed behind them. About 105,000 soldiers, 98,000 civilians, 17,500 vehicles and 350,000 tons of supplies were shipped south; one freighter, the SS *Meredith Victory*, carried 14,000 refugees.\n\n**Read more:** [Battle of Chosin Reservoir — Wikipedia](https://en.wikipedia.org/wiki/Battle_of_Chosin_Reservoir)\n\n*Image: Wikimedia Commons (USS Begor off Hungnam, 24 December 1950; U.S. Navy photo).*"
   }
