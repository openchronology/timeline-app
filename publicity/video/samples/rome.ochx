 ],
 "events": [
  {
   "id": "h-kings",
   "time": "-85898016000/1",
   "metadata": {
    "title": "The kings",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2",
    "datePrecision": "Chapter heading, placed at the start of 753 BCE."
   }
  },
  {
   "id": "founding",
   "time": "-85889116800/1",
   "metadata": {
    "title": "Founding of Rome",
    "description": "In legend, **Romulus** founds the city on the **Palatine Hill** after killing his twin **Remus**. The year 753 BCE is the antiquarian **Varro**'s reckoning, and 21 April, the festival of the Parilia, was celebrated as Rome's birthday.",
    "tags": [
     "legend",
     "ruler"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Founding_of_Rome",
     "https://en.wikipedia.org/wiki/Romulus_and_Remus"
    ],
    "datePrecision": "Legendary. 753 BCE is the Varronian date (other ancient writers gave 748 or 728 BCE); 21 April is the traditional day, placed as if it were a Julian date.",
    "historicalDate": "21 April 753 BCE (the Parilia)",
    "calendar": "Roman (pre-Julian Republican)"
   }
  },
  {
   "id": "palatine-huts",
   "time": "-85785091200/1",
   "metadata": {
    "title": "Iron Age huts on the Palatine",
    "description": "Archaeologists have found postholes of **Iron Age huts** on the Palatine and burials in the valley below, showing villages on Rome's hills by the 8th century BCE, whatever the truth of the legend.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Palatine_Hill",
     "https://en.wikipedia.org/wiki/Founding_of_Rome"
    ],
    "datePrecision": "Archaeological: the 8th century BCE, around the traditional founding; placed at 750 BCE."
   }
  },
  {
   "id": "cloaca",
   "time": "-81054172800/1",
   "metadata": {
    "title": "Cloaca Maxima",
    "description": "The **Great Drain**, credited by tradition to **Tarquinius Priscus**, drained the valley that became the **Forum**. Rebuilt many times, part of it still carries water to the Tiber.",
    "tags": [
     "building",
     "legend"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Cloaca_Maxima"
    ],
    "datePrecision": "About 600 BCE, by tradition; the dating is approximate."
   }
  },
  {
   "id": "lapis-niger",
   "time": "-79791868800/1",
   "metadata": {
    "title": "Lapis Niger inscription",
    "description": "A stone post under the black paving of the **Forum** carries one of the oldest known inscriptions in **Latin**, a sacred law that mentions a king (*rex*).",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lapis_Niger"
    ],
    "datePrecision": "About 570–550 BCE, from the letter forms; placed at 560 BCE."
   }
  },
  {
   "id": "tarquin-expelled",
   "time": "-78182409600/1",
   "metadata": {
    "title": "The last king expelled",
    "description": "After his son **Sextus Tarquinius** rapes **Lucretia**, **Lucius Junius Brutus** leads the Romans to drive out **Tarquinius Superbus**. Rome swears never again to have a king.",
    "tags": [
     "legend",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Overthrow_of_the_Roman_monarchy",
     "https://www.gutenberg.org/ebooks/19725"
    ],
    "datePrecision": "Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years. Placed at mid-year."
   }
  },
  {
   "id": "h-republic",
   "time": "-78198134400/1",
   "metadata": {
    "title": "The early Republic",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2",
    "datePrecision": "Chapter heading, placed at the start of 509 BCE."
   }
  },
  {
   "id": "first-consuls",
   "time": "-78181977600/1",
   "metadata": {
    "title": "The first consuls",
    "description": "Two magistrates elected for one year, the **consuls**, take the king's power: by tradition **Brutus** and **Collatinus**, Lucretia's husband. The yearly pair of consuls names Roman years for a thousand years.",
    "tags": [
     "politics",
     "legend"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Roman_consul",
     "https://en.wikipedia.org/wiki/Roman_Republic"
    ],
    "datePrecision": "Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years. Placed five days after the expulsion so the two can be told apart."
   }
  },
  {
   "id": "jupiter-temple",
   "time": "-78176534400/1",
   "metadata": {
    "title": "Temple of Jupiter on the Capitol",
    "description": "The great temple of **Jupiter Optimus Maximus**, begun under the kings, is dedicated in the Republic's first year, by tradition on the Ides of September.",
    "tags": [
     "building",
     "religion"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Temple_of_Jupiter_Optimus_Maximus"
    ],
    "datePrecision": "13 September 509 BCE in the pre-Julian Roman calendar, which had drifted from the seasons; its Julian equivalent is uncertain, so it is placed as if it were a Julian date. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years.",
    "historicalDate": "13 September 509 BCE",
    "calendar": "Roman (pre-Julian Republican)"
   }
  },
  {
   "id": "regillus",
   "time": "-77772268800/1",
   "metadata": {
    "title": "Battle of Lake Regillus",
    "description": "Rome defeats the **Latin League**, which had backed the exiled Tarquins; legend says **Castor and Pollux** fought for Rome.",
    "tags": [
     "war",
     "legend"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Lake_Regillus"
    ],
    "datePrecision": "Known to the year (496 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "secession",
   "time": "-77709196800/1",
   "metadata": {
    "title": "First secession of the plebs",
    "description": "The **plebeians** walk out of the city to the Sacred Mount and refuse to fight until they win officers of their own, the **tribunes of the plebs**.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Secessio_plebis",
     "https://en.wikipedia.org/wiki/Tribune_of_the_plebs"
    ],
    "datePrecision": "Known to the year (494 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "twelve-tables",
   "time": "-76320662400/1",
   "metadata": {
    "title": "The Twelve Tables",
    "description": "A board of ten, the **decemviri**, writes Rome's laws down for the first time and posts them in the Forum on twelve tablets: the foundation of **Roman law**, learned by heart by schoolboys for centuries.",
    "tags": [
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Twelve_Tables",
     "https://avalon.law.yale.edu/ancient/twelve_tables.asp"
    ],
    "datePrecision": "Drafted in 451–450 BCE (Varronian dates); placed at 450 BCE. The text survives only in later quotations."
   }
  },
  {
   "id": "canuleia",
   "time": "-76162809600/1",
   "metadata": {
    "title": "Lex Canuleia",
    "description": "A tribune's law lets **patricians and plebeians marry**, which one of the Twelve Tables had forbidden.",
    "tags": [
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lex_Canuleia"
    ],
    "datePrecision": "Known to the year (445 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "veii",
   "time": "-74616508800/1",
   "metadata": {
    "title": "Veii captured",
    "description": "**Marcus Furius Camillus** takes the Etruscan city of **Veii**, Rome's neighbour and rival, after a long siege, doubling Rome's territory.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Veii"
    ],
    "datePrecision": "Known to the year (396 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "allia",
   "time": "-74426169600/1",
   "metadata": {
    "title": "Gauls sack Rome",
    "description": "Gauls under **Brennus** rout the Romans at the **Allia** and sack the city; only the Capitol holds out. The day of the defeat stayed an unlucky day in the Roman calendar.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_the_Allia",
     "https://en.wikipedia.org/wiki/Sack_of_Rome_(390_BC)"
    ],
    "datePrecision": "18 July 390 BCE in the pre-Julian Roman calendar, which had drifted from the seasons; its Julian equivalent is uncertain, so it is placed as if it were a Julian date. The year is Varronian; Polybius's reckoning gives 387 or 386 BCE.",
    "historicalDate": "18 July 390 BCE",
    "calendar": "Roman (pre-Julian Republican)"
   }
  },
  {
   "id": "servian-wall",
   "time": "-74048515200/1",
   "metadata": {
    "title": "Servian Wall",
    "description": "After the Gallic sack Rome rings its hills with a wall of tufa blocks about 11 km long. It is named after the king **Servius Tullius**, but the surviving wall dates from the 4th century BCE.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Servian_Wall"
    ],
    "datePrecision": "Begun about 378 BCE (Livy); placed at mid-year."
   }
  },
  {
   "id": "licinian",
   "time": "-73701360000/1",
   "metadata": {
    "title": "Licinian–Sextian laws",
    "description": "The tribunes **Licinius** and **Sextius** carry laws opening the consulship to plebeians; **Lucius Sextius** becomes the first plebeian consul the next year.",
    "tags": [
     "law",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Licinio-Sextian_rogations"
    ],
    "datePrecision": "Known to the year (367 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "caudine",
   "time": "-72249667200/1",
   "metadata": {
    "title": "Caudine Forks",
    "description": "In the **Second Samnite War** a Roman army is trapped in a mountain pass and made to pass under a yoke of spears, a famous humiliation.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_the_Caudine_Forks"
    ],
    "datePrecision": "Known to the year (321 BCE); placed at mid-year. Traditional (Varronian) date; the early chronology was reconstructed by Roman antiquarians centuries later and may be off by years."
   }
  },
  {
   "id": "via-appia",
   "time": "-71965670400/1",
   "metadata": {
    "title": "Via Appia begun",
    "description": "The censor **Appius Claudius Caecus** builds the first great Roman road, south to Capua; it was later carried on to **Brundisium**. Long stretches of its paving survive.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Appian_Way"
    ],
    "datePrecision": "Known to the year (312 BCE); placed at mid-year. The aqueduct of the same year is placed ten days later so the two can be told apart."
   }
  },
  {
   "id": "aqua-appia",
   "time": "-71964806400/1",
   "metadata": {
    "title": "Aqua Appia",
    "description": "The same censor builds Rome's **first aqueduct**, about 16 km long and almost all underground.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Aqua_Appia"
    ],
    "datePrecision": "Known to the year (312 BCE); placed at mid-year. Placed ten days after the Via Appia."
   }
  },
  {
   "id": "sentinum",
   "time": "-71429299200/1",
   "metadata": {
    "title": "Battle of Sentinum",
    "description": "Rome defeats Samnites and Gauls together in the largest battle yet fought in Italy, deciding the **Third Samnite War**.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Sentinum"
    ],
    "datePrecision": "Known to the year (295 BCE); placed at mid-year."
   }
  },
  {
   "id": "hortensia",
   "time": "-71176838400/1",
   "metadata": {
    "title": "Lex Hortensia",
    "description": "After a last secession, the dictator **Quintus Hortensius** makes resolutions of the plebeian assembly binding on all Romans: usually taken as the end of the **Conflict of the Orders**.",
    "tags": [
     "law",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lex_Hortensia"
    ],
    "datePrecision": "Known to the year (287 BCE); placed at mid-year."
   }
  },
  {
   "id": "asculum",
   "time": "-70924377600/1",
   "metadata": {
    "title": "Battle of Asculum",
    "description": "King **Pyrrhus** of Epirus beats the Romans a second time, at such a cost that a victory too dear to win is still called a **Pyrrhic victory**.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Asculum"
    ],
    "datePrecision": "Known to the year (279 BCE); placed at mid-year."
   }
  },
  {
   "id": "beneventum",
   "time": "-70798147200/1",
   "metadata": {
    "title": "Battle of Beneventum",
    "description": "Pyrrhus is checked and leaves Italy; within a few years Rome controls the peninsula south of the Po.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Beneventum_(275_BC)"
    ],
    "datePrecision": "Known to the year (275 BCE); placed at mid-year."
   }
  },
  {
   "id": "h-carthage",
   "time": "-70466630400/1",
   "metadata": {
    "title": "Rome against Carthage",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2",
    "datePrecision": "Chapter heading, placed at the start of 264 BCE."
   }
  },
  {
   "id": "mylae",
   "time": "-70324761600/1",
   "metadata": {
    "title": "Battle of Mylae",
    "description": "Rome's new fleet, using the **corvus**, a boarding bridge, wins its first great sea battle against Carthage under **Gaius Duilius**.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Mylae"
    ],
    "datePrecision": "Known to the year (260 BCE); placed at mid-year."
   }
  },
  {
   "id": "aegates",
   "time": "-69735254400/1",
   "metadata": {
    "title": "Battle of the Aegates",
    "description": "A Roman fleet destroys Carthage's off western Sicily and ends the **First Punic War**; Sicily becomes Rome's first overseas territory.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_the_Aegates"
    ],
    "datePrecision": "10 March 241 BCE in the pre-Julian Roman calendar, which had drifted from the seasons; its Julian equivalent is uncertain, so it is placed as if it were a Julian date.",
    "historicalDate": "10 March 241 BCE",
    "calendar": "Roman (pre-Julian Republican)"
   }
  },
  {
   "id": "andronicus",
   "time": "-69693609600/1",
   "metadata": {
    "title": "The first Latin play",
    "description": "**Livius Andronicus**, a Greek from Tarentum, stages a play translated from Greek at the Roman Games: the traditional beginning of **Latin literature**.",
    "tags": [
     "writing"
