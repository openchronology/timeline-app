    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#1f2a44",
    "textFont": "Georgia, serif",
    "measureColor": "#9c3b2a",
    "haloColor": "#f3ead7",
    "markerColor": "#1f3a5f",
