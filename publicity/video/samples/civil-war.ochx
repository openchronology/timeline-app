 ],
 "events": [
  {
   "id": "h-roots",
   "time": "-4733578800/1",
   "metadata": {
    "title": "Roots of the war, 1820–1860",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "missouri",
   "time": "-4727962800/1",
   "metadata": {
    "title": "Missouri Compromise",
    "description": "President **James Monroe** signs the act that admits Missouri as a slave state (with Maine as a free one) and bars slavery from the rest of the Louisiana Purchase north of 36°30′.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Missouri_Compromise",
     "https://www.archives.gov/milestone-documents/missouri-compromise"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "liberator",
   "time": "-4386423600/1",
   "metadata": {
    "title": "The Liberator",
    "description": "**William Lloyd Garrison**'s weekly first appears in Boston, demanding the immediate abolition of slavery. It runs until the Thirteenth Amendment is ratified.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/The_Liberator_(newspaper)"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "nat-turner",
   "time": "-4366378800/1",
   "metadata": {
    "title": "Nat Turner's rebellion",
    "description": "Enslaved preacher **Nat Turner** leads a revolt in Southampton County, Virginia, killing about 55 to 65 white people. Militias and mobs kill many Black people in reprisal; Turner is hanged, and Southern states tighten their slave codes.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Nat_Turner's_Rebellion"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "douglass-narrative",
   "time": "-3934206000/1",
   "metadata": {
    "title": "Narrative of the Life of Frederick Douglass",
    "description": "**Frederick Douglass**, who escaped slavery in Maryland in 1838, publishes his autobiography in Boston. It becomes the best-known account of slavery by someone who lived it.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Narrative_of_the_Life_of_Frederick_Douglass"
    ],
    "color": "#b0782a",
    "datePrecision": "Published in May 1845; placed on May 1."
   }
  },
  {
   "id": "tubman-escapes",
   "time": "-3794756400/1",
   "metadata": {
    "title": "Harriet Tubman escapes",
    "description": "**Harriet Tubman** escapes slavery on Maryland’s Eastern Shore to Philadelphia. She returns again and again over the next decade to lead family members and others to freedom.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Harriet_Tubman"
    ],
    "color": "#b0782a",
    "datePrecision": "Autumn 1849; the day is not recorded."
   }
  },
  {
   "id": "fugitive-slave-act",
   "time": "-3764343600/1",
   "metadata": {
    "title": "Fugitive Slave Act",
    "description": "Part of the **Compromise of 1850**: federal commissioners return people who escaped slavery, without a jury trial, and anyone who helps them faces fines and prison. It turns many Northerners against slavery.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Fugitive_Slave_Act_of_1850"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "uncle-toms-cabin",
   "time": "-3716910000/1",
   "metadata": {
    "title": "Uncle Tom's Cabin",
    "description": "**Harriet Beecher Stowe**'s novel, serialized in *The National Era* from June 1851, is published as a book. It sells about 300,000 copies in the United States in its first year.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Uncle_Tom's_Cabin"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "kansas-nebraska",
   "time": "-3647703600/1",
   "metadata": {
    "title": "Kansas–Nebraska Act",
    "description": "**Stephen Douglas**'s act organizes the Kansas and Nebraska territories and lets their settlers decide on slavery (\"popular sovereignty\"), repealing the Missouri Compromise line. Its opponents soon form the **Republican Party**.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Kansas–Nebraska_Act",
     "https://www.archives.gov/milestone-documents/kansas-nebraska-act"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "sack-of-lawrence",
   "time": "-3585322800/1",
   "metadata": {
    "title": "Sack of Lawrence",
    "description": "A proslavery posse ransacks **Lawrence**, Kansas, the free-state settlers’ town: presses destroyed, the Free State Hotel burned.",
    "tags": [
     "slavery",
     "west"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Sacking_of_Lawrence"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "sumner-caning",
   "time": "-3585236400/1",
   "metadata": {
    "title": "Sumner caned in the Senate",
    "description": "Representative **Preston Brooks** of South Carolina beats Senator **Charles Sumner** unconscious at his desk, two days after Sumner’s \"Crime against Kansas\" speech.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Caning_of_Charles_Sumner"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "pottawatomie",
   "time": "-3585063600/1",
   "metadata": {
    "title": "Pottawatomie massacre",
    "description": "**John Brown** and his followers kill five proslavery settlers along Pottawatomie Creek, Kansas, in reply to the sack of Lawrence.",
    "tags": [
     "slavery",
     "west"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Pottawatomie_massacre"
    ],
    "color": "#b0782a",
    "datePrecision": "The night of May 24–25, 1856."
   }
  },
  {
   "id": "dred-scott",
   "time": "-3560353200/1",
   "metadata": {
    "title": "Dred Scott v. Sandford",
    "description": "Chief Justice **Roger Taney**’s Supreme Court rules that Black Americans cannot be citizens and that Congress cannot bar slavery from the territories, so the Missouri Compromise was unconstitutional.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Dred_Scott_v._Sandford",
     "https://www.archives.gov/milestone-documents/dred-scott-v-sandford"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "brown-hanged",
   "time": "-3473866800/1",
   "metadata": {
    "title": "John Brown hanged",
    "description": "Convicted of treason against Virginia, murder and inciting slave insurrection, **John Brown** is hanged at Charles Town. Many in the North mourn him as a martyr; many in the South see Northern plots behind him.",
    "tags": [
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/John_Brown_(abolitionist)"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "h-secession",
   "time": "-3444922800/1",
   "metadata": {
    "title": "Election and secession",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "lincoln-elected",
   "time": "-3444490800/1",
   "metadata": {
    "title": "Lincoln elected president",
    "description": "**Abraham Lincoln**, the Republican who would keep slavery out of the territories, wins the presidency with no electoral votes from the South. Secession conventions follow within weeks.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/1860_United_States_presidential_election"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "crittenden",
   "time": "-3440862000/1",
   "metadata": {
    "title": "Crittenden Compromise proposed",
    "description": "Senator **John J. Crittenden** of Kentucky proposes amendments to protect slavery south of 36°30′ forever. Lincoln and most Republicans refuse to extend slavery, and it fails.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Crittenden_Compromise"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "sc-secedes",
   "time": "-3440689200/1",
   "metadata": {
    "title": "South Carolina secedes",
    "description": "A convention in Charleston votes unanimously to leave the Union, the first state to do so.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/South_Carolina_in_the_American_Civil_War"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "sc-declaration",
   "time": "-3440343600/1",
   "metadata": {
    "title": "South Carolina's Declaration of Causes",
    "description": "The convention’s **Declaration of the Immediate Causes** justifies secession by the \"increasing hostility on the part of the non-slaveholding States to the institution of slavery\", citing the free states’ refusal to return fugitives and Lincoln’s election.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/South_Carolina_Declaration_of_Secession",
     "https://avalon.law.yale.edu/19th_century/csa_scarsec.asp"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "mississippi-secedes",
   "time": "-3438961200/1",
   "metadata": {
    "title": "Mississippi secedes",
    "description": "Its convention’s declaration of causes begins: \"Our position is thoroughly identified with the institution of slavery—the greatest material interest of the world.\"",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Mississippi_in_the_American_Civil_War",
     "https://avalon.law.yale.edu/19th_century/csa_missec.asp"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "florida-secedes",
   "time": "-3438874800/1",
   "metadata": {
    "title": "Florida secedes",
    "description": "The third state to leave the Union.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Florida_in_the_American_Civil_War"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "alabama-secedes",
   "time": "-3438788400/1",
   "metadata": {
    "title": "Alabama secedes",
    "description": "The fourth state to leave the Union.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Alabama_in_the_American_Civil_War"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "georgia-secedes",
   "time": "-3438097200/1",
   "metadata": {
    "title": "Georgia secedes",
    "description": "Georgia’s declaration of causes, adopted ten days later, names the North’s hostility to slavery as the reason.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Georgia_in_the_American_Civil_War",
     "https://avalon.law.yale.edu/19th_century/csa_geosec.asp"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "louisiana-secedes",
   "time": "-3437492400/1",
   "metadata": {
    "title": "Louisiana secedes",
    "description": "The sixth state to leave the Union.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Louisiana_in_the_American_Civil_War"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "kansas-admitted",
   "time": "-3437233200/1",
   "metadata": {
    "title": "Kansas admitted as a free state",
    "description": "With Southern senators gone, Congress admits Kansas under its antislavery Wyandotte Constitution.",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Kansas",
     "https://en.wikipedia.org/wiki/Bleeding_Kansas"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "texas-secedes",
   "time": "-3436974000/1",
   "metadata": {
    "title": "Texas secedes",
    "description": "Its convention votes to leave, over Governor **Sam Houston**’s opposition; voters ratify it on February 23. Its declaration of causes defends slavery as the foundation of the state’s prosperity.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Texas_in_the_American_Civil_War",
     "https://avalon.law.yale.edu/19th_century/csa_texsec.asp"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "csa-formed",
   "time": "-3436369200/1",
   "metadata": {
    "title": "The Confederate States formed",
    "description": "Delegates of six seceded states, meeting in **Montgomery**, Alabama, since February 4, adopt a provisional constitution; Texas’s delegates join them later. The next day they choose **Jefferson Davis** as provisional president.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Confederate_States_of_America",
     "https://en.wikipedia.org/wiki/Provisional_Congress_of_the_Confederate_States"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "corwin",
   "time": "-3434468400/1",
   "metadata": {
    "title": "Corwin Amendment passes Congress",
    "description": "A last attempt at compromise: an amendment forbidding Congress ever to abolish slavery in the states. Lincoln does not oppose it; only a few states ratify it, and the war overtakes it.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Corwin_Amendment"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "csa-constitution",
   "time": "-3433690800/1",
   "metadata": {
    "title": "Confederate Constitution",
    "description": "The permanent constitution copies much of the U.S. one, but forbids any law \"denying or impairing the right of property in negro slaves\" and protects slavery in any new territory.",
    "tags": [
     "politics",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Constitution_of_the_Confederate_States",
     "https://avalon.law.yale.edu/19th_century/csa_csa.asp"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "cornerstone",
   "time": "-3432826800/1",
   "metadata": {
    "title": "Cornerstone Speech",
    "description": "Confederate vice president **Alexander Stephens**, at Savannah, says the new government’s \"cornerstone rests upon the great truth that the negro is not equal to the white man; that slavery … is his natural and normal condition.\"",
    "tags": [
     "slavery",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Cornerstone_Speech",
     "https://www.battlefields.org/learn/primary-sources/cornerstone-speech"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "h-1861",
   "time": "-3431876400/1",
   "metadata": {
    "title": "1861: The war begins",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "sumter",
   "time": "-3430909800/1",
   "metadata": {
    "title": "Fort Sumter",
    "description": "Confederate batteries open fire on the federal fort in Charleston Harbor at 4:30 in the morning. Major **Robert Anderson** surrenders it the next day: the war begins.",
    "tags": [
     "east"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Fort_Sumter",
     "https://www.nps.gov/fosu/index.htm"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "call-75000",
   "time": "-3430666800/1",
   "metadata": {
    "title": "Lincoln calls for 75,000 volunteers",
    "description": "Lincoln calls up 75,000 militia for ninety days to put down the rebellion. Four states of the upper South secede rather than send troops.",
    "tags": [
     "politics"
    ],
    "sources": [
