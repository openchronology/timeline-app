{
 "format": "openchronology",
 "version": 1,
 "title": "The Ember Crown",
 "description": "A story's timeline: the world's history and the saga of Ash and Mirelle, in years After the Reckoning (AR).\n\nAsh's thread is ember diamonds, Mirelle's is blue circles, the Hollow King's is violet squares; the world's events are gold. Links join a prophecy to what fulfils it.",
 "presentation": {
  "mode": "float",
  "unit": "AR",
  "scale": "31557600/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "fiction",
  "worldbuilding",
  "fantasy"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-shapes",
    "version": 2,
    "name": "Moment shapes",
    "description": "Choose geometric and flowchart symbols for moments and stack entries: decisions, processes, documents and more.",
    "fields": [
     {
      "kind": "shape",
      "metadataKey": "shape",
      "label": "Moment shape"
     },
     {
      "kind": "size",
      "metadataKey": "shapeSize",
      "label": "Moment size"
     }
    ],
    "marker": {
     "kind": "shape",
     "metadataKey": "shape"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.merge(api.shape(api.get(\"shape\")), api.size(api.get(\"shapeSize\"))); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 1,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors and fonts: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#efe6cf",
    "textFont": "Georgia, serif",
    "measureColor": "#d9a441",
    "haloColor": "#141b2e",
    "markerColor": "#d9a441",
    "durationColor": "#4a5a8a",
    "backgroundColor": "#141b2e"
   }
  }
 ],
 "events": [
  {
   "id": "h-first",
   "time": "0/1",
   "metadata": {
    "title": "The First Age",
    "tags": [
     "age"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "reckoning",
   "time": "0/1",
   "metadata": {
    "title": "The Reckoning",
    "description": "Fire falls from the sky and the old crown shatters into seven shards. Years are counted from this night.",
    "tags": [
     "world"
    ],
    "color": "#d9a441"
   }
  },
  {
   "id": "emberhold",
   "time": "6690211200/1",
   "metadata": {
    "title": "Emberhold founded",
    "description": "The smiths of the north raise a city around the largest shard, which never cools.",
    "tags": [
     "world"
    ],
    "color": "#d9a441"
   }
  },
  {
   "id": "h-salt",
   "time": "11991888000/1",
   "metadata": {
    "title": "The Salt Years",
    "tags": [
     "age"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "salt-treaty",
   "time": "12351644640/1",
   "metadata": {
    "title": "The Salt Treaty",
    "description": "The coast cities and Emberhold make peace; the Drowned Coast is left to no one.",
    "tags": [
     "world"
    ],
    "color": "#d9a441"
   }
  },
  {
   "id": "king-rises",
   "time": "12566236320/1",
   "metadata": {
    "title": "The Hollow King wakes",
    "description": "Beneath the Drowned Coast, something wearing a crown of salt begins to gather the shards.",
    "tags": [
     "hollow king"
    ],
    "color": "#9a7fd1",
    "shape": "square"
   }
  },
  {
   "id": "ash-born",
   "time": "12673532160/1",
   "metadata": {
    "title": "Ash is born",
    "description": "Born in the smiths' quarter of Emberhold, the night the great forge went dark.",
    "tags": [
     "ash"
    ],
    "color": "#e0603a",
    "shape": "diamond"
   }
  },
  {
   "id": "mirelle-born",
   "time": "12752426160/1",
   "metadata": {
    "title": "Mirelle is born",
    "description": "Born aboard a mapmaker's ship off the Drowned Coast.",
    "tags": [
     "mirelle"
    ],
    "color": "#6fa3d8",
    "shape": "circle"
   }
  },
  {
   "id": "h-saga",
   "time": "13191076800/1",
   "metadata": {
    "title": "The Ember Crown",
    "tags": [
     "age"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "prophecy",
   "time": "13228945920/1",
   "metadata": {
    "title": "The prophecy at Greyfen",
    "description": "*\"When the cold shard burns, a smith's hand and a sailor's map will meet, and the crown will be whole or the world will not.\"*\n\nFulfilled in 423 AR.",
    "tags": [
     "world",
     "prophecy"
    ],
    "color": "#d9a441"
   }
  },
  {
   "id": "shard",
   "time": "13263659280/1",
   "metadata": {
    "title": "Ash finds the cold shard",
    "description": "In the ashes of the old forge, a shard that burns without heat.",
    "tags": [
     "ash",
     "prophecy"
    ],
    "color": "#e0603a",
    "shape": "diamond"
   }
  },
  {
   "id": "map",
   "time": "13282593840/1",
   "metadata": {
    "title": "Mirelle maps the Drowned Coast",
    "description": "The only chart of the coast that shows the sunken road.",
    "tags": [
     "mirelle"
    ],
    "color": "#6fa3d8",
    "shape": "circle"
   }
  },
  {
   "id": "meeting",
   "time": "13292061120/1",
   "metadata": {
    "title": "Ash and Mirelle meet",
    "description": "At the harbour of Saltmere. Neither knows the prophecy yet.",
    "tags": [
     "ash",
     "mirelle",
     "prophecy"
    ],
    "color": "#d9a441",
    "shape": "diamond"
   }
  },
  {
   "id": "betrayal",
   "time": "13320462960/1",
   "metadata": {
    "title": "The betrayal at Saltmere",
    "description": "The harbour master sells Mirelle's chart to the Hollow King.",
    "tags": [
     "hollow king",
     "mirelle"
    ],
    "color": "#9a7fd1",
    "shape": "square"
   }
  },
  {
   "id": "ash-wounded",
   "time": "13333086000/1",
   "metadata": {
    "title": "Ash is wounded",
    "description": "The shard burns him for the first time.",
