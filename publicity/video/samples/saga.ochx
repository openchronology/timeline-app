     "world"
    ],
    "color": "#9a7fd1",
    "shape": "square"
   }
  },
  {
   "id": "reforged",
   "time": "13361487840/1",
   "metadata": {
    "title": "The crown reforged",
    "description": "Ash's hand and Mirelle's map: the prophecy at Greyfen is fulfilled.",
    "tags": [
