{
 "format": "openchronology",
 "version": 1,
 "title": "China, from the Neolithic to 1949",
 "description": "Chinese history on one line: the Neolithic cultures, the Xia of tradition, the Shang and Zhou, the empire from Qin to Qing, and the Republic, to the founding of the People’s Republic on 1 October 1949, with two later milestones. Dynasties, reigns and wars are durations; people, works, inventions and battles are moments.\n\n**How it is dated.** Before 841 BCE, the first year Chinese history dates year by year, the dates are the Xia–Shang–Zhou Chronology Project’s conventional figures, and approximate. Years are proleptic Gregorian with BCE (1 BCE is year 0); dates known to the day before 1582 are converted from the Julian dates in the sources, which are kept under Historical dates. Days are UTC date markers.\n\nA sample timeline built from the cited sources, not a definitive history.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "history",
  "china",
  "education"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-sources",
    "version": 1,
    "name": "Sources",
    "description": "Show and edit a series of source links for moments and stack entries.",
    "fields": [
     {
      "kind": "links",
      "metadataKey": "sources",
      "label": "Sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "historical-dates",
    "version": 1,
    "name": "Historical dates",
    "description": "Retain an original historical date and its calendar separately from the timeline coordinate and display calendar, such as a Julian date on a Gregorian timeline.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "historicalDate",
      "label": "Original historical date"
     },
     {
      "kind": "text",
      "metadataKey": "calendar",
      "label": "Original calendar"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "presumptive-outline",
    "version": 1,
    "name": "Presumptive outline",
    "description": "Mark moments, stack entries and durations as presumptive: not yet confirmed by evidence. They are drawn with a dashed outline, whatever their shape, color or icon, as events and causal factors charts draw presumptive events and conditions.",
    "fields": [
     {
      "kind": "toggle",
      "metadataKey": "presumptive",
      "label": "Presumptive (unconfirmed)"
     }
    ],
    "marker": {
     "kind": "outline",
     "metadataKey": "presumptive"
    },
    "targets": [
     "moments",
     "durations"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 2,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors, fonts and text sizes: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "text-size",
      "key": "textSize",
      "label": "Label size"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "text-size",
      "key": "measureSize",
      "label": "Measure size"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "textSize": "textSize",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "measureSize": "measureSize",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#1f2a44",
    "textFont": "Georgia, serif",
    "measureColor": "#9c3b2a",
    "haloColor": "#f3ead7",
    "markerColor": "#1f3a5f",
    "durationColor": "#9c3b2a",
    "backgroundColor": "#f3ead7"
   }
  }
 ],
 "events": [
  {
   "id": "h-neolithic",
   "time": "-219920400000/1",
   "metadata": {
    "title": "Neolithic cultures",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "hemudu",
   "time": "-213608966400/1",
   "metadata": {
    "title": "Hemudu: rice on the Yangtze",
    "description": "Villages of wooden houses on stilts near the Yangtze delta, with abundant cultivated **rice**, about 5000–4500 BCE: farming in China began along both the Yellow River and the Yangtze.",
    "tags": [
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Hemudu_culture"
    ],
    "datePrecision": "Approximate: a rounded archaeological date"
   }
  },
  {
   "id": "banpo",
   "time": "-204141945600/1",
   "metadata": {
    "title": "Banpo village",
    "description": "A **Yangshao** village near Xi’an, about 4800–4300 BCE: round houses, a ditch, kilns and painted pottery, some marked with signs.",
    "tags": [
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Banpo"
    ],
    "datePrecision": "Approximate: a rounded archaeological date"
   }
  },
  {
   "id": "taosi",
   "time": "-134716608000/1",
   "metadata": {
    "title": "Taosi",
    "description": "A large walled settlement of the late **Longshan** period in southern Shanxi, about 2300–1900 BCE, with elite tombs and a structure often read as an observatory.",
    "tags": [
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Taosi"
    ],
    "datePrecision": "Approximate: a rounded archaeological date"
   }
  },
  {
   "id": "h-bronze",
   "time": "-127458576000/1",
   "metadata": {
    "title": "The first dynasties",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "erlitou-palaces",
   "time": "-115782480000/1",
   "metadata": {
    "title": "Palaces and bronze at Erlitou",
    "description": "The city at **Erlitou** in the Yiluo valley has palace foundations and the earliest large-scale bronze casting in China, including the first known ritual vessels. Many Chinese archaeologists identify it with the late Xia; without written records, the link is unproven.",
    "tags": [
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Erlitou_culture"
    ],
    "datePrecision": "Approximate: a rounded archaeological date"
   }
  },
  {
   "id": "zhengzhou",
   "time": "-112626720000/1",
   "metadata": {
    "title": "The Shang at Zhengzhou",
    "description": "Walled cities of the **Erligang** culture at Zhengzhou and Yanshi mark the early Shang. The Chronology Project ties the dynasty’s start, about 1600 BCE, to the Yanshi city.",
    "tags": [
     "dynasty",
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Shang_dynasty",
     "https://en.wikipedia.org/wiki/Xia–Shang–Zhou_Chronology_Project"
    ],
    "datePrecision": "Approximate: the Xia–Shang–Zhou Chronology Project's conventional date"
   }
  },
  {
   "id": "pan-geng",
   "time": "-103159699200/1",
   "metadata": {
    "title": "Pan Geng moves to Yin",
    "description": "King **Pan Geng** moves the Shang capital to Yin, near modern Anyang, where it stays until the dynasty’s fall. The Chronology Project dates the move about 1300 BCE.",
    "tags": [
     "dynasty",
     "ruler"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Pan_Geng",
     "https://en.wikipedia.org/wiki/Yinxu"
    ],
    "datePrecision": "Approximate: the Xia–Shang–Zhou Chronology Project's conventional date"
   }
  },
  {
   "id": "oracle-bones",
   "time": "-101581862400/1",
   "metadata": {
    "title": "Oracle bones",
    "description": "Questions to the ancestors, carved on ox shoulder blades and turtle shells at Yin from the reign of **Wu Ding** (from 1250 BCE in the Chronology Project): the earliest substantial body of Chinese writing. Recognized as writing in 1899, they confirmed the Shang kings of the later histories.",
    "tags": [
     "writing",
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Oracle_bone",
     "https://en.wikipedia.org/wiki/Oracle_bone_script"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Approximate: the Xia–Shang–Zhou Chronology Project's conventional date"
   }
  },
  {
   "id": "fu-hao",
   "time": "-100003939200/1",
   "metadata": {
    "title": "Tomb of Fu Hao",
    "description": "**Fu Hao**, a consort of Wu Ding, led armies according to the oracle bones. Her tomb at Yin, found undisturbed in 1976, held well over a thousand objects of jade, bronze and bone, and thousands of cowry shells. She died about 1200 BCE.",
    "tags": [
     "archaeology",
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Fu_Hao",
     "https://whc.unesco.org/en/list/1114/"
    ],
    "datePrecision": "Approximate: about this year"
   }
  },
  {
   "id": "sanxingdui",
   "time": "-96848265600/1",
   "metadata": {
    "title": "Sanxingdui",
    "description": "Pits in Sichuan with bronze masks, standing figures and gold, dated about 1200–1000 BCE (placed here mid-range): a bronze culture contemporary with the late Shang but unlike it, with no writing found.",
    "tags": [
     "archaeology"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Sanxingdui"
    ],
    "datePrecision": "Approximate: a rounded archaeological date"
   }
  },
  {
   "id": "muye",
   "time": "-95144198400/1",
   "metadata": {
    "title": "Battle of Muye",
    "description": "King **Wu of Zhou** defeats Di Xin, the last Shang king, and the Zhou claim the **Mandate of Heaven**. The Chronology Project dates it to 1046 BCE (20 January); older chronologies proposed dozens of dates, from 1130 to 1018 BCE, 1122 and 1027 the best known.",
    "tags": [
     "war",
     "dynasty"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Muye",
     "https://en.wikipedia.org/wiki/Xia–Shang–Zhou_Chronology_Project"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Approximate: the Xia–Shang–Zhou Chronology Project's conventional date"
   }
  },
  {
   "id": "h-zhou",
   "time": "-93692592000/1",
   "metadata": {
    "title": "Zhou",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "gonghe",
   "time": "-88675084800/1",
   "metadata": {
    "title": "841 BCE: the first dated year",
    "description": "After King Li is driven out, the **Gonghe Regency** governs until 828 BCE. Sima Qian’s year-by-year tables begin here: 841 BCE is the earliest year of Chinese history dated year by year. (The Cambridge History of Ancient China starts the regency in 842.)",
    "tags": [
     "dynasty"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Gonghe_Regency",
     "https://ctext.org/shiji"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Year"
   }
  },
  {
   "id": "haojing",
   "time": "-86466009600/1",
   "metadata": {
    "title": "Haojing falls",
    "description": "Rebels and the Quanrong sack the western capital and kill **King You**. The court moves east to Luoyang, and the Western Zhou gives way to the Eastern.",
    "tags": [
     "war",
     "dynasty"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/King_You_of_Zhou"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Year"
   }
  },
  {
   "id": "chunqiu",
   "time": "-84919708800/1",
   "metadata": {
    "title": "Spring and Autumn Annals begin",
    "description": "The chronicle of the state of **Lu** records its years from 722 to 481 BCE, and gives the period its name. Tradition says Confucius edited it.",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Spring_and_Autumn_Annals"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Year"
   }
  },
  {
   "id": "confucius",
   "time": "-79523510400/1",
   "metadata": {
    "title": "Confucius born",
    "description": "**Kong Qiu**, known as Kongzi or **Confucius**, is born in Lu, in 551 BCE by the usual reckoning. He taught that order begins with personal virtue, ritual and right relationships.",
    "tags": [
     "thought"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Confucius"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Traditional date; the earliest sources disagree"
   }
  },
  {
   "id": "laozi",
   "time": "-80154662400/1",
   "metadata": {
    "title": "Laozi and the Daodejing",
    "description": "Tradition makes **Laozi** an older contemporary of Confucius, born, by one account, in 571 BCE, and the author of the **Daodejing**, the founding text of Daoism. Whether he lived is debated; the oldest manuscript, from Guodian, is from about 300 BCE.",
    "tags": [
     "thought",
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Laozi",
     "https://en.wikipedia.org/wiki/Tao_Te_Ching",
     "https://ctext.org/dao-de-jing"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Traditional date; the earliest sources disagree"
   }
  },
  {
   "id": "sunzi",
   "time": "-77914137600/1",
   "metadata": {
    "title": "Sunzi, The Art of War",
    "description": "Attributed to **Sun Wu (Sunzi)**, a general of the state of Wu around 500 BCE. Most scholars think the text took its form in the Warring States period.",
    "tags": [
     "thought",
     "writing",
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/The_Art_of_War",
     "https://ctext.org/art-of-war"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Traditional date; the earliest sources disagree"
   }
  },
  {
   "id": "confucius-dies",
   "time": "-77251449600/1",
   "metadata": {
    "title": "Confucius dies",
    "description": "He dies in Lu in 479 BCE, his teaching known only to his followers; it becomes state orthodoxy under the Han, three centuries later.",
    "tags": [
     "thought"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Confucius"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Year"
   }
  },
  {
   "id": "analects",
   "time": "-74758377600/1",
   "metadata": {
    "title": "The Analects",
    "description": "The **Analects** (Lunyu), sayings of Confucius and his disciples, compiled by his followers over the generations after his death and settled in its present form under the Han.",
    "tags": [
     "thought",
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Analects",
     "https://ctext.org/analects"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Approximate: about this year"
   }
  },
  {
   "id": "jin-partition",
   "time": "-74853072000/1",
   "metadata": {
    "title": "Partition of Jin",
    "description": "The Zhou king recognizes **Han, Zhao and Wei**, carved out of the state of Jin, as states. Sima Guang begins his history of the Warring States here; Sima Qian uses 475 BCE.",
    "tags": [
     "dynasty",
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Partition_of_Jin"
    ],
    "datePrecision": "Year"
   }
  },
  {
   "id": "mencius",
   "time": "-73874764800/1",
   "metadata": {
    "title": "Mencius born",
    "description": "**Mengzi (Mencius)**, about 372–289 BCE, the most influential follower of Confucius, argued that human nature is good.",
    "tags": [
     "thought"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Mencius",
     "https://ctext.org/mengzi"
    ],
    "color": "#6b4a7a",
    "datePrecision": "Traditional date; the earliest sources disagree"
   }
  },
  {
   "id": "shang-yang",
   "time": "-73369843200/1",
   "metadata": {
    "title": "Shang Yang’s reforms in Qin",
    "description": "Under Duke Xiao, **Shang Yang** remakes Qin: land for farmers, ranks for soldiers, harsh and uniform laws. The **Legalist** state he built went on to conquer the others.",
    "tags": [
     "thought",
     "dynasty"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Shang_Yang"
    ],
    "datePrecision": "Year"
   }
  },
  {
   "id": "dujiangyan",
   "time": "-70198531200/1",
   "metadata": {
    "title": "Dujiangyan",
    "description": "The Qin governor **Li Bing** splits the Min River in Sichuan without a dam, to irrigate the Chengdu plain and tame its floods, about 256 BCE. It still works.",
    "tags": [
     "invention"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Dujiangyan"
    ],
    "color": "#2f6b4f",
    "datePrecision": "Approximate: about this year"
   }
  },
  {
   "id": "changping",
   "time": "-70340400000/1",
   "metadata": {
    "title": "Battle of Changping",
    "description": "Qin destroys the army of **Zhao**, its strongest rival; the histories say the surrendered soldiers were killed.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Changping"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Year"
   }
  },
  {
   "id": "zhou-ends",
   "time": "-70214169600/1",
   "metadata": {
    "title": "The last Zhou king",
    "description": "Qin takes the royal domain and King Nan dies: the Zhou, the longest-lasting dynasty, ends after about 790 years.",
    "tags": [
     "dynasty"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Zhou_dynasty"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Year"
   }
  },
  {
   "id": "ying-zheng",
   "time": "-69898636800/1",
   "metadata": {
    "title": "Ying Zheng becomes king of Qin",
    "description": "The future First Emperor comes to the Qin throne as a boy of about thirteen.",
    "tags": [
     "ruler"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Qin_Shi_Huang"
    ],
    "color": "#b0862f",
    "datePrecision": "Year"
   }
  },
  {
   "id": "h-empire",
   "time": "-69393715200/1",
   "metadata": {
    "title": "Qin and Han: the empire",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "unification",
   "time": "-69109718400/1",
   "metadata": {
    "title": "Qin unifies China",
    "description": "With Qi, the last of the six states, conquered, Ying Zheng takes a new title: **Qin Shi Huang, the First Emperor**. Qin standardizes the script, weights and measures, coins and axle widths, and governs through commanderies instead of fiefs.",
    "tags": [
     "dynasty",
     "ruler",
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Qin's_wars_of_unification",
     "https://en.wikipedia.org/wiki/Qin_Shi_Huang"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Year"
   }
  },
  {
