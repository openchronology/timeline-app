   "metadata": {
    "title": "Unemployment: 4.7%",
    "description": "**4.7%** of the civilian labor force out of work, about **2.7 million** people, in the Bureau of Labor Statistics' estimates (Stanley Lebergott's, the basis of Historical Statistics' series). No one measured unemployment directly at the time: these are later estimates, and others who count relief workers as employed put the 1930s lower. By 1944 it is under 2%.",
    "tags": [
     "economy"
    ],
    "sources": [
     "https://www.bls.gov/opub/mlr/1948/article/pdf/labor-force-employment-and-unemployment-1929-39-estimating-methods.pdf"
    ],
    "color": "#3d3a33",
    "datePrecision": "An annual average for the year, placed at mid-year."
   }
