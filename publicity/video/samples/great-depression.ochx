 "events": [
  {
   "id": "h-twenties",
   "time": "-1577905200/1",
   "metadata": {
    "title": "The boom and its cracks",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "prohibition-begins",
   "time": "-1576522800/1",
   "metadata": {
    "title": "Prohibition begins",
    "description": "The **Eighteenth Amendment** takes effect: the manufacture, sale and transport of alcoholic drinks are banned nationwide.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Prohibition_in_the_United_States"
    ],
    "color": "#5b4a8a"
   }
  },
  {
   "id": "farm-prices",
   "time": "-1562180400/1",
   "metadata": {
    "title": "Farm prices collapse",
    "description": "Crop prices, high during the war, fall sharply in the **depression of 1920–21**. Farmers who had borrowed to buy land stay in trouble for the rest of the decade, years before the Crash.",
    "tags": [
     "farm"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Depression_of_1920–1921",
     "https://en.wikipedia.org/wiki/Agriculture_in_the_United_States"
    ],
    "color": "#b0782a",
    "datePrecision": "Prices fell through the second half of 1920; placed at mid-year."
   }
  },
  {
   "id": "bull-begins",
   "time": "-1525978800/1",
   "metadata": {
    "title": "The bull market begins",
    "description": "The Dow Jones Industrial Average closes at **63.90**, its low after the 1920–21 slump. From here it rises six-fold in eight years.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Dow_Jones_Industrial_Average",
     "https://en.wikipedia.org/wiki/Roaring_Twenties"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "coolidge",
   "time": "-1464807600/1",
   "metadata": {
    "title": "Coolidge becomes president",
    "description": "**Warren G. Harding** dies in office and **Calvin Coolidge** succeeds him: the years of \"Coolidge prosperity\", low taxes and light regulation.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Calvin_Coolidge"
    ],
    "color": "#5b4a8a"
   }
  },
  {
   "id": "miami-hurricane",
   "time": "-1366052400/1",
   "metadata": {
    "title": "The Miami hurricane",
    "description": "A major hurricane strikes **Miami**, finishing off the Florida land boom, which had already begun to falter as buyers ran short.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/1926_Miami_hurricane",
     "https://en.wikipedia.org/wiki/Florida_land_boom_of_the_1920s"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "mcnary-haugen",
   "time": "-1352228400/1",
   "metadata": {
    "title": "Coolidge vetoes farm relief",
    "description": "Coolidge vetoes the **McNary–Haugen** bill, which would have had the government buy farm surpluses to raise prices; he vetoes it again in 1928.",
    "tags": [
     "farm"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/McNary–Haugen_Farm_Relief_Bill"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "hoover-inaugurated",
   "time": "-1288465200/1",
   "metadata": {
    "title": "Hoover inaugurated",
    "description": "**Herbert Hoover**, an engineer and Commerce Secretary under Coolidge, becomes president, promising that the end of poverty is in sight.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Herbert_Hoover",
     "https://en.wikipedia.org/wiki/Presidency_of_Herbert_Hoover"
    ],
    "color": "#5b4a8a"
   }
  },
  {
   "id": "mini-crash",
   "time": "-1286564400/1",
   "metadata": {
    "title": "A warning break",
    "description": "Prices break on fears that the **Federal Reserve** will tighten credit for speculation; **Charles E. Mitchell** of National City Bank offers loans to calm the market, and it recovers.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929",
     "https://en.wikipedia.org/wiki/Charles_E._Mitchell"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "farm-board",
   "time": "-1279566000/1",
   "metadata": {
    "title": "Agricultural Marketing Act",
    "description": "Hoover's answer to the farm problem: a **Federal Farm Board** to lend to cooperatives and hold surpluses off the market.",
    "tags": [
     "farm",
     "policy"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Agricultural_Marketing_Act_of_1929"
    ],
    "color": "#b0782a"
   }
  },
  {
   "id": "unemployment-1929",
   "time": "-1278183600/1",
   "metadata": {
    "title": "Unemployment: 3.2%",
    "description": "**3.2%** of the civilian labor force out of work, about **1.6 million** people, in the Bureau of Labor Statistics' estimates (Stanley Lebergott's, the basis of Historical Statistics' series). No one measured unemployment directly at the time: these are later estimates, and others who count relief workers as employed put the 1930s lower.",
    "tags": [
     "economy"
    ],
    "sources": [
     "https://www.bls.gov/opub/mlr/1948/article/pdf/labor-force-employment-and-unemployment-1929-39-estimating-methods.pdf",
     "https://en.wikipedia.org/wiki/Great_Depression_in_the_United_States"
    ],
    "color": "#3d3a33",
    "datePrecision": "An annual average for the year, placed at mid-year."
   }
  },
  {
   "id": "nber-peak",
   "time": "-1275505200/1",
   "metadata": {
    "title": "The business cycle peaks",
    "description": "The **National Bureau of Economic Research** dates the peak of the expansion to August 1929: the economy was already turning down two months before the Crash.",
    "tags": [
     "economy"
    ],
    "sources": [
     "https://www.nber.org/research/data/us-business-cycle-expansions-and-contractions",
     "https://www.federalreservehistory.org/essays/great-depression"
    ],
    "color": "#3d3a33",
    "datePrecision": "The NBER dates peaks and troughs to the month (August 1929); placed at its first day."
   }
  },
  {
   "id": "h-crash",
   "time": "-1272740400/1",
   "metadata": {
    "title": "The Crash",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "dow-peak",
   "time": "-1272654000/1",
   "metadata": {
    "title": "The Dow peaks at 381.17",
    "description": "The Dow Jones Industrial Average closes at **381.17**, its high. Much of the buying is **on margin**: stock bought with money borrowed from brokers, against the stock itself.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929",
     "https://www.federalreservehistory.org/essays/stock-market-crash-of-1929"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "babson",
   "time": "-1272481200/1",
   "metadata": {
    "title": "The Babson break",
    "description": "The investment adviser **Roger Babson** tells a business conference that \"a crash is coming\"; prices fall sharply that afternoon.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Roger_Babson",
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "hatry",
   "time": "-1271185200/1",
   "metadata": {
    "title": "The Hatry crash in London",
    "description": "The London Stock Exchange suspends trading in the companies of **Clarence Hatry**, whose empire is found to rest on fraud; British investors' losses unsettle markets in New York.",
    "tags": [
     "world",
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Clarence_Hatry",
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#2f6b73"
   }
  },
  {
   "id": "fisher",
   "time": "-1269025200/1",
   "metadata": {
    "title": "\"A permanently high plateau\"",
    "description": "The Yale economist **Irving Fisher** says that stock prices have reached \"what looks like a permanently high plateau\". Nine days later the panic begins.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Irving_Fisher"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Said at a dinner in mid-October 1929 and reported the next day."
   }
  },
  {
   "id": "black-thursday",
   "time": "-1268211600/1",
   "metadata": {
    "title": "Black Thursday",
    "description": "Selling floods the New York Stock Exchange from the opening: a record **12.9 million shares** change hands, and the ticker runs hours behind the trading.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929",
     "https://www.federalreservehistory.org/essays/stock-market-crash-of-1929"
    ],
    "color": "#9c3b2a",
    "datePrecision": "The day is exact; placed at the 10 a.m. opening bell, New York's time."
   }
  },
  {
   "id": "bankers",
   "time": "-1268204400/1",
   "metadata": {
    "title": "The bankers' meeting",
    "description": "Leaders of New York's biggest banks (**Thomas Lamont** of J.P. Morgan, **Albert Wiggin** of Chase, **Charles Mitchell** of National City) meet at the House of Morgan and agree to buy stocks to steady the market.",
    "tags": [
     "market",
     "banking"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Around midday, as contemporary accounts give it."
   }
  },
  {
   "id": "whitney",
   "time": "-1268199000/1",
   "metadata": {
    "title": "Whitney bids 205 for Steel",
    "description": "**Richard Whitney**, the Exchange's vice president, walks onto the floor and bids well above the market for **U.S. Steel**, then for other leading stocks. Prices rally, and the Dow closes the day down only about 2%.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Richard_Whitney_(financier)",
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 1:30 p.m., as most accounts give it."
   }
  },
  {
   "id": "black-monday",
   "time": "-1267902000/1",
   "metadata": {
    "title": "Black Monday",
    "description": "No rescue comes this time: the Dow falls **38.33 points, 12.8%**, to 260.64, its worst day of the Crash in percentage terms.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "black-tuesday",
   "time": "-1267815600/1",
   "metadata": {
    "title": "Black Tuesday",
    "description": "About **16.4 million shares** trade and the Dow falls another **11.7%**, to 230.07: down 23% in two days.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929",
     "https://www.federalreservehistory.org/essays/stock-market-crash-of-1929"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "nov-low",
   "time": "-1266519600/1",
   "metadata": {
    "title": "The Crash bottoms at 198.60",
    "description": "The Dow closes at **198.60**, nearly half its September peak. It then recovers through the winter, and many expect the worst is over.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "h-slide",
   "time": "-1262286000/1",
   "metadata": {
    "title": "The slide, 1930–1932",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "spring-rally",
   "time": "-1253127600/1",
   "metadata": {
    "title": "The Dow recovers to 294",
    "description": "The rally after the Crash peaks at **294.07**. From here the market falls, with pauses, for more than two years.",
    "tags": [
     "market"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wall_Street_crash_of_1929",
     "https://en.wikipedia.org/wiki/Timeline_of_the_Great_Depression"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "bruning-chancellor",
   "time": "-1254682800/1",
   "metadata": {
    "title": "Brüning becomes chancellor",
    "description": "**Heinrich Brüning** becomes Germany's chancellor and governs by presidential emergency decree, cutting spending and wages to keep the budget balanced and reparations paid.",
    "tags": [
     "world"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Heinrich_Brüning",
     "https://en.wikipedia.org/wiki/Great_Depression_in_Germany"
    ],
    "color": "#2f6b73"
   }
  },
  {
   "id": "smoot-hawley",
   "time": "-1247857200/1",
   "metadata": {
    "title": "Smoot–Hawley tariff",
    "description": "Hoover signs the **Smoot–Hawley Tariff Act**, raising duties on thousands of imports, despite a petition from more than a thousand economists. Other countries retaliate and world trade shrinks.",
    "tags": [
     "policy",
     "world"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Smoot–Hawley_Tariff_Act",
     "https://www.federalreservehistory.org/essays/smoot-hawley-tariff"
    ],
    "color": "#4f7a4a"
   }
  },
  {
   "id": "reichstag-1930",
   "time": "-1240167600/1",
   "metadata": {
    "title": "Nazis gain in Germany",
    "description": "In the Reichstag election the **Nazi party** grows from 12 seats to 107, the second-largest party, on the back of the slump's discontent.",
    "tags": [
     "world",
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/1930_German_federal_election"
    ],
    "color": "#2f6b73"
   }
  },
  {
   "id": "caldwell",
   "time": "-1235502000/1",
   "metadata": {
    "title": "Caldwell and Company fails",
    "description": "The **Bank of Tennessee**, part of the Nashville financial empire of Caldwell and Company, closes; its affiliates follow, and runs spread through the South: the first banking panic.",
    "tags": [
     "banking"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Rogers_Caldwell",
     "https://www.federalreservehistory.org/essays/banking-panics-1930-31"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "bank-of-us",
   "time": "-1232564400/1",
   "metadata": {
    "title": "The Bank of United States closes",
    "description": "The **Bank of United States**, a New York commercial bank with some 400,000 depositors, many of them immigrants, closes after a run: the largest US bank failure to that time.",
    "tags": [
     "banking"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Bank_of_United_States",
     "https://www.federalreservehistory.org/essays/banking-panics-1930-31"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "creditanstalt",
   "time": "-1219518000/1",
   "metadata": {
    "title": "Creditanstalt fails",
    "description": "Vienna's **Creditanstalt**, Austria's largest bank, announces it has lost most of its capital. The crisis spreads to Hungary and Germany and becomes a European financial panic.",
    "tags": [
     "world",
     "banking"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Creditanstalt",
     "https://www.federalreservehistory.org/essays/creditanstalt-failure"
    ],
    "color": "#2f6b73"
   }
  },
  {
   "id": "moratorium-announced",
   "time": "-1216062000/1",
   "metadata": {
    "title": "The Hoover Moratorium",
