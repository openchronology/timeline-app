  {
   "id": "light-out",
   "start": "1791934800/1",
   "end": "1792143000/1",
   "metadata": {
    "title": "Aisle 14 end light out",
    "description": "**Causal factor.** The aisle end was dark: the picker could not be seen from the forklift, and the forklift’s rear could not be seen from the cross-aisle.\n\nEvidence: the fault sheet; camera 7; repaired 16 October at 09:30.",
    "tags": [
     "condition",
     "causal factor",
     "barrier"
    ],
    "color": "#bc6663",
    "arrows": [
     {
      "target": {
       "moment": "collision"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "no-spotter",
   "start": "1792091400/1",
   "end": "1792130400/1",
   "metadata": {
    "title": "No spotter on shift",
    "description": "**Causal factor.** The procedure requires a spotter to guide forklifts reversing out of narrow aisles. None was on shift.\n\nEvidence: the rota; the attendance record.",
    "tags": [
     "condition",
     "causal factor",
     "barrier"
    ],
    "color": "#bc6663",
    "arrows": [
     {
      "target": {
       "moment": "collision"
      },
      "arrow": "to"
     }
    ]
   }
  },
