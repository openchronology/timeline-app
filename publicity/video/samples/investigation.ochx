{
 "format": "openchronology",
 "version": 1,
 "title": "Investigation: forklift collision, aisle 14",
 "description": "A made-up investigation laid out as an Events and Causal Factors chart: a forklift reversing out of aisle 14 on the night shift of 15–16 October strikes a picker crossing the aisle end. Primary events, conditions, evidence, causal factors and the root cause. The warehouse, its people and its records are invented.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "investigation",
  "causal factor analysis",
  "made up"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-stacks",
    "version": 2,
    "name": "Moment stacks",
    "description": "Keep ordered entries inside a moment, sharing its time and the timeline’s other metadata plugins. Stacks cannot be nested.",
    "fields": [
     {
      "kind": "stack",
      "metadataKey": "stack",
      "label": "Moment stack"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-shapes",
    "version": 3,
    "name": "Moment shapes",
    "description": "Choose geometric and flowchart symbols for moments and stack entries: decisions, processes, documents, conditions and more.",
    "fields": [
     {
      "kind": "shape",
      "metadataKey": "shape",
      "label": "Moment shape"
     },
     {
      "kind": "size",
      "metadataKey": "shapeSize",
      "label": "Moment size"
     }
    ],
    "marker": {
     "kind": "shape",
     "metadataKey": "shape"
    },
    "shapes": [
     "ellipse"
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.merge(api.shape(api.get(\"shape\")), api.size(api.get(\"shapeSize\"))); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "presumptive-outline",
    "version": 1,
    "name": "Presumptive outline",
    "description": "Mark moments, stack entries and durations as presumptive: not yet confirmed by evidence. They are drawn with a dashed outline, whatever their shape, color or icon, as events and causal factors charts draw presumptive events and conditions.",
    "fields": [
     {
      "kind": "toggle",
      "metadataKey": "presumptive",
      "label": "Presumptive (unconfirmed)"
     }
    ],
    "marker": {
     "kind": "outline",
     "metadataKey": "presumptive"
    },
    "targets": [
     "moments",
     "durations"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "relationship-arrows",
    "version": 1,
    "name": "Relationship arrows",
    "description": "Draw arrowheads on relationship arcs, such as from causes to their effect. In an event's details, choose one of its relationships and an arrow toward the other end, toward this one, or both ways; an arc shows what either end chose. Arrows are a drawing convention kept on the events: relationships stay undirected, and separating by relationships does not follow them.",
    "fields": [
     {
      "kind": "relationship-arrows",
      "metadataKey": "arrows",
      "label": "Relationship arrows"
     }
    ],
    "targets": [
     "moments",
     "durations"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  }
 ],
 "events": [
  {
   "id": "risk-review",
   "time": "1791795600/1",
   "metadata": {
    "title": "No risk review of longer shifts",
    "description": "**Root cause.** Peak-season night shifts were extended from 8 to 10 hours from 12 October. The change was approved without the risk review the site procedure requires, so nobody checked that safety roles, rest breaks and lighting checks still fitted the longer shift.\n\nEvidence: the change request (no risk assessment attached); interview with the shift manager.",
    "tags": [
     "condition",
     "causal factor",
     "root cause"
    ],
    "color": "#bc6663",
    "shape": "ellipse",
    "arrows": [
     {
      "target": {
       "duration": "long-shifts"
      },
      "arrow": "to"
     },
     {
      "target": {
       "moment": "sick-call"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "fault-report",
   "time": "1791944100/1",
   "metadata": {
    "title": "Light fault: no work order",
    "description": "A picker reported the light at the end of aisle 14 on the fault sheet. No work order was raised, so it was not repaired before the collision.\n\nEvidence: fault sheet, 14 October; the maintenance log.",
    "tags": [
     "condition",
     "barrier"
    ],
    "color": "#d6ad4c",
    "shape": "ellipse",
    "arrows": [
     {
      "target": {
       "duration": "light-out"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "sick-call",
   "time": "1792091400/1",
   "metadata": {
    "title": "Spotter sick, not replaced",
    "description": "The assigned spotter called in sick. The shift started without a replacement.\n\nEvidence: the attendance record; interview with the shift supervisor.",
    "tags": [
     "condition"
    ],
    "color": "#d6ad4c",
    "shape": "ellipse",
    "arrows": [
     {
      "target": {
       "duration": "no-spotter"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "briefing",
   "time": "1792094100/1",
   "metadata": {
    "title": "Pre-shift briefing",
    "description": "Held as usual, but without the lighting walk the procedure lists (the written procedure assumes a 22:00 start).",
    "tags": [
     "secondary event"
    ],
    "color": "#7aadc4",
    "shape": "process",
    "shapeSize": "small"
   }
  },
  {
   "id": "run-start",
   "time": "1792116750/1",
   "metadata": {
    "title": "FL-3 starts a run",
    "description": "The driver of forklift FL-3 starts moving pallets into aisle 14, in the seventh hour of a 10-hour shift.\n\nEvidence: FL-3 telematics; the task log.",
    "tags": [
     "primary event"
    ],
    "shape": "process",
    "shapeSize": "large",
    "arrows": [
     {
      "target": {
       "moment": "enters"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "enters",
   "time": "1792117908/1",
   "metadata": {
    "title": "FL-3 enters aisle 14",
    "description": "Forward, to set a pallet down at the far end.\n\nEvidence: FL-3 telematics.",
    "tags": [
     "primary event"
    ],
    "shape": "process",
    "shapeSize": "large",
    "arrows": [
     {
      "target": {
       "moment": "reverses"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "picker-statement",
   "time": "1792117800/1",
   "metadata": {
    "title": "Picker crosses (statement)",
    "description": "**Unconfirmed.** The picker's statement puts this at about 02:30. Camera 7 shows 02:33:20; the camera's clock was checked against the network time afterwards, so the camera's time is used.",
    "tags": [
     "primary event",
     "presumptive"
    ],
    "shape": "process",
    "datePrecision": "About 02:30, from memory",
    "presumptive": true
   }
  },
  {
   "id": "crosses",
   "time": "1792118000/1",
   "metadata": {
    "title": "Picker crosses (camera 7)",
    "description": "The picker walks along the cross-aisle towards zone C, past the end of aisle 14, which is dark.\n\nEvidence: camera 7.",
    "tags": [
     "primary event"
    ],
    "shape": "process",
    "shapeSize": "large",
    "arrows": [
     {
      "target": {
       "moment": "collision"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "horn",
   "time": "1792118036/1",
   "metadata": {
    "title": "Horn sounded? (driver)",
    "description": "**Unconfirmed.** The driver says he sounded the horn before reversing. The picker heard no horn, and camera 7 has no sound. Kept as presumptive until it's confirmed or ruled out.",
    "tags": [
     "primary event",
     "presumptive"
    ],
    "shape": "process",
    "presumptive": true
   }
  },
  {
   "id": "reverses",
   "time": "1792118038/1",
   "metadata": {
    "title": "FL-3 reverses out",
    "description": "Reversing at about 7 km/h, with no spotter at the aisle end.\n\nEvidence: FL-3 telematics; camera 7.",
    "tags": [
     "primary event"
    ],
    "shape": "process",
    "shapeSize": "large",
    "arrows": [
     {
      "target": {
       "moment": "collision"
      },
      "arrow": "to"
     }
    ]
   }
  },
  {
   "id": "collision",
   "time": "44802951234/25",
   "metadata": {
    "title": "Collision at aisle 14",
    "description": "The reversing forklift strikes the picker at the end of aisle 14. The picker's leg is injured.\n\nThe time is camera 7’s frame: 02:34:09 and 9/25 of a second (frame 9 of 25 in that second).",
    "tags": [
     "primary event",
     "incident"
    ],
    "color": "#bc6663",
    "shape": "diamond",
    "shapeSize": "large",
    "stack": [
     {
      "id": "c-dark",
      "metadata": {
       "title": "Condition: aisle end dark",
       "description": "The light at the end of aisle 14 had been out since Tuesday.",
       "shape": "ellipse",
       "color": "#bc6663"
      }
     },
     {
      "id": "c-spotter",
      "metadata": {
       "title": "Condition: no spotter",
       "description": "The procedure requires one for reversing out of narrow aisles.",
       "shape": "ellipse",
       "color": "#bc6663"
      }
     },
     {
      "id": "c-fatigue",
      "metadata": {
       "title": "Presumptive: fatigue",
       "description": "The seventh hour of a 10-hour shift, with no break after 01:00. Fatigue not confirmed.",
       "shape": "ellipse",
       "color": "#d6ad4c",
       "presumptive": true
      }
     },
     {
      "id": "ev-camera",
      "metadata": {
       "title": "Evidence: camera 7 frame",
       "description": "Contact at 02:34:09.36, frame 9 of 25 in that second; the clock checked against network time.",
       "shape": "document"
      }
     },
     {
      "id": "ev-telematics",
      "metadata": {
       "title": "Evidence: FL-3 telematics",
       "description": "Reversing at about 7 km/h; speed and direction logged once a second.",
       "shape": "document"
      }
     },
     {
      "id": "ev-statements",
      "metadata": {
       "title": "Evidence: statements",
       "description": "Driver, picker and supervisor, taken on 16 October; the horn is disputed.",
       "shape": "document"
      }
     }
    ]
   }
  },
