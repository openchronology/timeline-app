{
 "format": "openchronology",
 "version": 1,
 "title": "The history of artificial intelligence",
 "description": "From Llull's combinatorial wheels and Leibniz's calculus of reasoning to today's large language models: ideas, programs, machines, games, people, companies and the policy around them. Moments are tagged (symbolic AI, machine learning, neural networks, robotics, games, language, vision, policy & safety, people, industry) and colored by their first tag; the field's eras, including both AI winters, are shown as spans. Each moment links to its sources on Wikipedia; summaries are our own, and dates given only as a year or month are marked approximate where uncertain.\n\nCompiled by an AI assistant (Claude) through the OpenChronology API and reviewed by the account owner. Coverage of the most recent years stops at the assistant's knowledge.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "plugins": [
  {
   "enabled": true,
   "manifest": {
    "id": "rich-text-notes",
    "name": "Rich text notes",
    "notes": {
     "kind": "markdown"
    },
    "fields": [],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }",
    "version": 1,
    "apiVersion": 1,
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "moment-headings",
    "name": "Headings",
    "fields": [
     {
      "kind": "heading",
      "label": "Heading level",
      "metadataKey": "headingLevel"
     },
     {
      "kind": "font",
      "label": "Heading font",
      "metadataKey": "headingFont"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ],
    "version": 1,
    "apiVersion": 1,
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "moment-colors",
    "name": "Moment colors",
    "fields": [
     {
      "kind": "color",
      "label": "Moment color",
      "metadataKey": "color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }",
    "version": 2,
    "apiVersion": 1,
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "moment-icons",
    "name": "Moment icons",
    "fields": [
     {
      "kind": "image-url",
      "label": "Moment icon URL",
      "metadataKey": "iconUrl"
     }
    ],
    "marker": {
     "kind": "image",
     "metadataKey": "iconUrl"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.icon(\"iconUrl\"); }",
    "version": 2,
    "apiVersion": 1,
    "description": "Show a circular image on each moment, enlarge it on hover, and edit its image URL in the details panel."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "moment-sources",
    "name": "Sources",
    "fields": [
     {
      "kind": "links",
      "label": "Sources",
      "metadataKey": "sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }",
    "version": 1,
    "apiVersion": 1,
    "description": "Show and edit a series of source links for moments and stack entries."
   }
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "enabled": true,
   "manifest": {
    "id": "duration-backgrounds",
    "name": "Duration backgrounds",
    "fields": [
     {
      "kind": "image-url",
      "label": "Background image URL",
      "metadataKey": "backgroundUrl"
     }
    ],
    "targets": [
     "durations"
    ],
    "version": 1,
    "apiVersion": 1,
    "background": {
     "kind": "image",
     "metadataKey": "backgroundUrl"
    },
    "description": "Show an image behind the timeline where a duration lies, centered between its visible start and end and filling the timeline. Smaller durations show above larger ones, and edges blend into each other."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "expand-on-hover",
    "name": "Expand on hover",
    "fields": [],
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }",
    "summary": {
     "kind": "radial"
    },
    "version": 1,
    "apiVersion": 1,
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed."
   }
  },
  {
   "enabled": true,
   "manifest": {
    "id": "timeline-theme",
    "name": "Timeline theme",
    "theme": {
     "halo": "haloColor",
     "text": "textColor",
     "marker": "markerColor",
     "measure": "measureColor",
     "duration": "durationColor",
     "textFont": "textFont",
     "background": "backgroundColor",
     "measureFont": "measureFont"
    },
    "fields": [],
    "version": 1,
    "settings": [
     {
      "key": "textColor",
      "kind": "color",
      "label": "Label color"
     },
     {
      "key": "textFont",
      "kind": "font",
      "label": "Label font"
     },
     {
      "key": "measureColor",
      "kind": "color",
      "label": "Measure color"
     },
     {
      "key": "measureFont",
      "kind": "font",
      "label": "Measure font"
     },
     {
      "key": "haloColor",
      "kind": "color",
      "label": "Halo color"
     },
     {
      "key": "markerColor",
      "kind": "color",
      "label": "Marker color"
     },
     {
      "key": "durationColor",
      "kind": "color",
      "label": "Duration color"
     },
     {
      "key": "backgroundColor",
      "kind": "color",
      "label": "Background color"
     }
    ],
    "apiVersion": 1,
    "description": "Choose the timeline's colors and fonts: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win."
   },
   "settings": {
    "textFont": "'Trebuchet MS', 'Helvetica Neue', sans-serif",
    "haloColor": "#080a1c",
    "textColor": "#e9ecff",
    "markerColor": "#38e1ff",
    "measureColor": "#8c9bff",
    "durationColor": "#3d3285",
    "backgroundColor": "#0b0e24"
   }
  }
 ],
 "tags": [
  "history",
  "artificial intelligence",
  "computing",
  "chronology"
 ],
 "image": {
  "alt": "IBM's Deep Blue, the chess computer that defeated Garry Kasparov in 1997, on display at the Computer History Museum",
  "url": "https://upload.wikimedia.org/wikipedia/commons/b/be/Deep_Blue.jpg"
 },
