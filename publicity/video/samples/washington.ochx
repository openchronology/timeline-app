 ],
 "events": [
  {
   "id": "h-youth",
   "time": "-7510561200/1",
   "metadata": {
    "title": "Youth in Virginia",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "birth",
   "time": "-7506068400/1",
   "metadata": {
    "title": "Born at Popes Creek",
    "description": "**George Washington** is born at Popes Creek, Westmoreland County, Virginia, the first child of **Augustine Washington** and his second wife, **Mary Ball Washington**. The date was written at the time as 11 February 1731/32, in the Old Style; on the Gregorian calendar it is 22 February 1732, the birthday he kept after 1752.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington",
     "https://en.wikipedia.org/wiki/George_Washington_Birthplace_National_Monument"
    ],
    "color": "#a8742a",
    "datePrecision": "Gregorian date; Old Style 11 February 1731/32 (the year began on 25 March)",
    "historicalDate": "11 February 1731/32",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "hunting-creek",
   "time": "-7415866800/1",
   "metadata": {
    "title": "Move to Little Hunting Creek",
    "description": "The family moves up the Potomac to Augustine’s plantation on **Little Hunting Creek**, the land that later became Mount Vernon.",
    "tags": [
     "family",
     "land"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Mount_Vernon"
    ],
    "color": "#a8742a",
    "datePrecision": "Year only",
    "historicalDate": "1735",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "ferry-farm",
   "time": "-7292314800/1",
   "metadata": {
    "title": "Move to Ferry Farm",
    "description": "The family moves to **Ferry Farm**, on the Rappahannock across from Fredericksburg, where George spends most of his boyhood.",
    "tags": [
     "family",
     "land"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Ferry_Farm"
    ],
    "color": "#a8742a",
    "datePrecision": "Late 1738; the day is not known",
    "historicalDate": "1738",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "father-dies",
   "time": "-7153729200/1",
   "metadata": {
    "title": "His father dies",
    "description": "**Augustine Washington** dies at Ferry Farm when George is eleven. George inherits Ferry Farm and ten enslaved people; his elder half-brother **Lawrence** inherits Little Hunting Creek.",
    "tags": [
     "family",
     "slavery"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Augustine_Washington"
    ],
    "color": "#a8742a",
    "historicalDate": "12 April 1743",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "mount-vernon-named",
   "time": "-7147767600/1",
   "metadata": {
    "title": "Lawrence names Mount Vernon",
    "description": "**Lawrence Washington** marries **Anne Fairfax** and names the Little Hunting Creek estate **Mount Vernon**, after Admiral Edward Vernon, under whom he had served. The Fairfax connection opens doors for George.",
    "tags": [
     "family",
     "land"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lawrence_Washington_(1718–1752)",
     "https://en.wikipedia.org/wiki/Mount_Vernon"
    ],
    "color": "#a8742a",
    "datePrecision": "Year only (1743)",
    "historicalDate": "1743",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "culpeper",
   "time": "-6955786800/1",
   "metadata": {
    "title": "Surveyor of Culpeper County",
    "description": "Licensed by the College of William & Mary, Washington takes the oath as surveyor of the new **Culpeper County**, at seventeen. He gave up the post in 1750 but went on surveying, and buying land, in the Shenandoah Valley.",
    "tags": [
     "land"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#4f6b3a",
    "historicalDate": "20 July 1749",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "barbados-sail",
   "time": "-6886666800/1",
   "metadata": {
    "title": "Sails for Barbados",
    "description": "Washington sails with **Lawrence**, who is ill with tuberculosis, hoping the climate will help him. It is the only time George ever leaves mainland North America.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://founders.archives.gov/documents/Washington/01-01-02-0002-0002",
     "https://en.wikipedia.org/wiki/George_Washington_House_(Barbados)"
    ],
    "color": "#a8742a",
    "historicalDate": "28 September 1751",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "smallpox",
   "time": "-6882346800/1",
   "metadata": {
    "title": "Smallpox in Barbados",
    "description": "Two weeks after landing at Bridgetown, George falls ill with **smallpox**. He recovers, lightly scarred, and immune: a protection that mattered when the disease swept the Continental Army.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington_House_(Barbados)",
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#a8742a",
    "historicalDate": "17 November 1751",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "lawrence-dies",
   "time": "-6860574000/1",
   "metadata": {
    "title": "Lawrence dies",
    "description": "**Lawrence Washington** dies of tuberculosis at Mount Vernon. The estate passes to his widow **Anne** and their daughter, with George to inherit if the daughter died without heirs.",
    "tags": [
     "family",
     "land"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lawrence_Washington_(1718–1752)"
    ],
    "color": "#a8742a",
    "historicalDate": "26 July 1752",
    "calendar": "Julian (Old Style)"
   }
  },
  {
   "id": "new-style",
   "time": "-6857204400/1",
   "metadata": {
    "title": "Britain switches calendars",
    "description": "Under the **Calendar Act** of 1750, Britain and its colonies adopt the Gregorian calendar: Wednesday 2 September 1752 is followed by Thursday 14 September. The year had already been made to begin on 1 January. Washington’s birthday moves from 11 to 22 February.",
    "tags": [
     "world"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Calendar_(New_Style)_Act_1750",
     "https://en.wikipedia.org/wiki/Old_Style_and_New_Style_dates"
    ],
    "color": "#6b5a43"
   }
  },
  {
   "id": "freemason",
   "time": "-6852798000/1",
   "metadata": {
    "title": "Becomes a Freemason",
    "description": "Washington is initiated into the **Masonic lodge** at Fredericksburg, at twenty.",
    "tags": [
     "family"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#a8742a"
   }
  },
  {
   "id": "adjutant",
   "time": "-6849428400/1",
   "metadata": {
    "title": "Adjutant, with the rank of major",
    "description": "Governor **Robert Dinwiddie** commissions him adjutant of Virginia’s southern militia district, with the rank of major: the post Lawrence had held for the whole colony.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://founders.archives.gov/documents/Washington/02-01-02-0024"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "h-regiment",
   "time": "-6832148400/1",
   "metadata": {
    "title": "The Virginia Regiment",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "le-boeuf-set-out",
   "time": "-6821607600/1",
   "metadata": {
    "title": "Sent to warn the French",
    "description": "Dinwiddie sends him from Williamsburg to the French commander in the Ohio Country, with a letter demanding that France withdraw from land Virginia claimed.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Fort_Le_Boeuf",
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "le-boeuf",
   "time": "-6818065200/1",
   "metadata": {
    "title": "At Fort Le Boeuf",
    "description": "Washington reaches **Fort Le Boeuf**, near Lake Erie, and delivers the letter. The French commander, **Jacques Legardeur de Saint-Pierre**, politely refuses to leave.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Fort_Le_Boeuf"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "journal",
   "time": "-6814954800/1",
   "metadata": {
    "title": "Back in Williamsburg: his journal",
    "description": "After a winter journey (he nearly drowned crossing the Allegheny), he reports to Dinwiddie, who has his account printed as **The Journal of Major George Washington**; it is reprinted in London and makes his name.",
    "tags": [
     "writing",
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington",
     "https://founders.archives.gov/documents/Washington/01-01-02-0003-0002"
    ],
    "color": "#3d6f73"
   }
  },
  {
   "id": "lt-colonel",
   "time": "-6809943600/1",
   "metadata": {
    "title": "Lieutenant colonel",
    "description": "Commissioned lieutenant colonel and second in command of the new **Virginia Regiment**, he leads its advance party toward the Forks of the Ohio.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Virginia_Regiment",
     "https://en.wikipedia.org/wiki/Battle_of_Fort_Necessity"
    ],
    "color": "#9c3b2a",
    "datePrecision": "March 1754; the day is approximate"
   }
  },
  {
   "id": "jumonville",
   "time": "-6803550000/1",
   "metadata": {
    "title": "Jumonville Glen",
    "description": "Washington’s men and **Tanacharison**’s Mingo warriors surprise a French party in a glen; its commander, **Joseph Coulon de Jumonville**, is among the dead. The skirmish helps set off the **French and Indian War**.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Jumonville_Glen"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "fort-necessity",
   "time": "-6800439600/1",
   "metadata": {
    "title": "Surrender at Fort Necessity",
    "description": "Colonel since Joshua Fry’s death, Washington is besieged at **Fort Necessity** by a larger French and Indian force and surrenders. The terms he signed, in French, called Jumonville’s death an assassination, a phrase he later said had been mistranslated to him.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_Fort_Necessity"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "resigns-1754",
   "time": "-6789985200/1",
   "metadata": {
    "title": "Resigns his commission",
    "description": "When the regiment is broken into independent companies, where he would rank as a captain, he resigns rather than accept the demotion.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#9c3b2a",
    "datePrecision": "Late 1754; the day is approximate"
   }
  },
  {
   "id": "lease",
   "time": "-6786010800/1",
   "metadata": {
    "title": "Leases Mount Vernon",
    "description": "Lawrence’s widow **Anne**, now married to George Lee, leases Mount Vernon to George, with the enslaved people who belonged to it, for a yearly rent of tobacco or cash.",
    "tags": [
     "land",
     "slavery"
    ],
    "sources": [
     "https://founders.archives.gov/documents/Washington/02-01-02-0116",
     "https://en.wikipedia.org/wiki/Mount_Vernon"
    ],
    "color": "#4f6b3a"
   }
  },
  {
   "id": "braddock-aide",
   "time": "-6773569200/1",
   "metadata": {
    "title": "Aide to General Braddock",
    "description": "Washington joins Major General **Edward Braddock**’s expedition against Fort Duquesne as a volunteer aide-de-camp, without rank.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Braddock_Expedition"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "monongahela",
   "time": "-6768385200/1",
   "metadata": {
    "title": "Braddock’s defeat",
    "description": "At the **Battle of the Monongahela**, French troops and their Native allies rout Braddock’s army; Braddock is mortally wounded. Washington, with two horses shot under him and bullet holes in his coat, helps organize the retreat.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Battle_of_the_Monongahela"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "colonel-1755",
   "time": "-6765274800/1",
   "metadata": {
    "title": "Colonel of the Virginia Regiment",
    "description": "Dinwiddie appoints him colonel of the re-formed **Virginia Regiment** and commander of all Virginia’s forces, at twenty-three, to defend a long frontier.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://founders.archives.gov/documents/Washington/02-02-02-0001-0002",
     "https://en.wikipedia.org/wiki/Virginia_Regiment"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "elected-burgess",
   "time": "-6672394800/1",
   "metadata": {
    "title": "Elected a burgess",
    "description": "While still on campaign, he is elected to the **House of Burgesses** for Frederick County, where he had lost in 1755.",
    "tags": [
     "politics"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/George_Washington",
     "https://en.wikipedia.org/wiki/House_of_Burgesses"
    ],
    "color": "#1f3a5f"
   }
  },
  {
   "id": "loyalhanna",
   "time": "-6662804400/1",
   "metadata": {
    "title": "Friendly fire near Loyalhanna",
    "description": "In the dusk, two parties of Virginians fire on each other near Fort Ligonier; fourteen are killed. Washington rides between the lines to stop it.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Forbes_Expedition",
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "duquesne",
   "time": "-6661681200/1",
   "metadata": {
    "title": "Fort Duquesne taken",
    "description": "The French blow up and abandon **Fort Duquesne** as General **John Forbes**’s army arrives; the British build Fort Pitt on the site, today’s Pittsburgh.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Forbes_Expedition",
     "https://en.wikipedia.org/wiki/Fort_Duquesne"
    ],
    "color": "#9c3b2a"
   }
  },
  {
   "id": "resigns-1758",
   "time": "-6659953200/1",
   "metadata": {
    "title": "Leaves the army",
    "description": "Denied the regular British commission he had sought, and with the Ohio frontier secured, he resigns his commission at the end of 1758.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Virginia_Regiment",
     "https://en.wikipedia.org/wiki/George_Washington"
    ],
    "color": "#9c3b2a",
    "datePrecision": "December 1758; the day is approximate"
   }
  },
  {
   "id": "h-planter",
   "time": "-6658570800/1",
   "metadata": {
    "title": "Planter and burgess",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "marriage",
