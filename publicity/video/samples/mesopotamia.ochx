{
 "format": "openchronology",
 "version": 1,
 "title": "Ancient Mesopotamia",
 "description": "From the first farming villages, about 7000 BCE, through Uruk's first cities and writing, Sumer, Akkad, Ur, Hammurabi's Babylon, the Kassites and the Assyrian empires, to Nebuchadnezzar's Babylon and its fall to Cyrus in 539 BCE, with Alexander's death in Babylon in 323 BCE as an epilogue. A sample timeline built from the sources cited on each moment, mostly their Wikipedia articles; not a definitive history.\n\n**How to read it.** Chapter headings mark the eras. Periods, empires and reigns are durations; inventions, writings, laws, cities, buildings and battles are moments, coloured by tag.\n\n**Dates.** Before about 1500 BCE they depend on the chronology: this timeline uses the conventional **middle chronology** (Hammurabi 1792–1750 BCE, the Hittite sack of Babylon 1595 BCE); the high and low chronologies put the same events decades earlier or later. Prehistoric dates are approximate, and each moment's **Date precision** says how its date is known. A moment known only to the year sits at the start of that year. The display is proleptic Gregorian; days known from Babylonian records keep the Julian date historians give beside them (**Original historical date**), about six days later in the sixth century BCE.",
 "presentation": {
  "mode": "gregorian",
  "unit": "",
  "scale": "1/1",
  "origin": "0/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 6
 },
 "tags": [
  "history",
  "mesopotamia",
  "ancient near east",
  "education"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-headings",
    "version": 1,
    "name": "Headings",
    "description": "Let a moment act as a heading or marker: only its title shows, sized as a heading from level 1 to 6, and the title is what you click. Choose its font (Times New Roman by default). Headings still group into summaries with other moments.",
    "fields": [
     {
      "kind": "heading",
      "metadataKey": "headingLevel",
      "label": "Heading level"
     },
     {
      "kind": "font",
      "metadataKey": "headingFont",
      "label": "Heading font"
     }
    ],
    "marker": {
     "kind": "heading",
     "metadataKey": "headingLevel"
    },
    "targets": [
     "moments"
    ]
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-sources",
    "version": 1,
    "name": "Sources",
    "description": "Show and edit a series of source links for moments and stack entries.",
    "fields": [
     {
      "kind": "links",
      "metadataKey": "sources",
      "label": "Sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "dating-context",
    "version": 1,
    "name": "Dating context",
    "description": "Explain the precision and coordinate convention of a moment. An exact stored coordinate can still represent an approximate age or a calendar-day marker.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "datePrecision",
      "label": "Date precision"
     },
     {
      "kind": "multiline",
      "metadataKey": "coordinateConvention",
      "label": "Coordinate convention"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "historical-dates",
    "version": 1,
    "name": "Historical dates",
    "description": "Retain an original historical date and its calendar separately from the timeline coordinate and display calendar, such as a Julian date on a Gregorian timeline.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "historicalDate",
      "label": "Original historical date"
     },
     {
      "kind": "text",
      "metadataKey": "calendar",
      "label": "Original calendar"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 2,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors, fonts and text sizes: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "text-size",
      "key": "textSize",
      "label": "Label size"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "text-size",
      "key": "measureSize",
      "label": "Measure size"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "textSize": "textSize",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "measureSize": "measureSize",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#1f2a44",
    "textFont": "Georgia, serif",
    "measureColor": "#9c3b2a",
    "haloColor": "#f3ead7",
    "markerColor": "#1f3a5f",
    "durationColor": "#9c3b2a",
    "backgroundColor": "#f3ead7"
   }
  }
 ],
 "events": [
  {
   "id": "h-villages",
   "time": "-283034304000/1",
   "metadata": {
    "title": "The first farming villages",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "jarmo",
   "time": "-283034304000/1",
   "metadata": {
    "title": "Jarmo",
    "description": "A farming village in the Zagros foothills of northern Iraq, about 7000 BCE: mud houses, domesticated wheat, barley, goats and sheep. One of the earliest excavated villages near Mesopotamia.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Jarmo"
    ],
    "color": "#a8742a",
    "datePrecision": "Approximate (archaeological dating); placed at the conventional round date."
   }
  },
  {
   "id": "oueili",
   "time": "-267255849600/1",
   "metadata": {
    "title": "Tell el-'Oueili",
    "description": "The oldest known settlement on the southern plain, near Larsa, with the earliest phase of the **Ubaid** culture (Ubaid 0), about 6500 BCE.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Tell_el-'Oueili",
     "https://en.wikipedia.org/wiki/Ubaid_period"
    ],
    "color": "#a8742a",
    "datePrecision": "Approximate (archaeological dating); placed at the conventional round date."
   }
  },
  {
   "id": "hassuna",
   "time": "-251477308800/1",
   "metadata": {
    "title": "Hassuna villages",
    "description": "The **Hassuna** culture of the early sixth millennium BCE: farming villages of northern Mesopotamia with painted pottery and storage bins.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Hassuna_culture"
    ],
    "color": "#a8742a",
    "datePrecision": "Approximate (archaeological dating); placed at the conventional round date."
   }
  },
  {
   "id": "choga-mami",
   "time": "-235698854400/1",
   "metadata": {
    "title": "Irrigation canals",
    "description": "The **Samarra** culture, about 5500 BCE, left some of the earliest evidence of irrigation farming, such as the canals at Choga Mami.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Samarra_culture",
     "https://en.wikipedia.org/wiki/Choga_Mami"
    ],
    "color": "#2b7a8c",
    "datePrecision": "Approximate (archaeological dating); placed at the conventional round date."
   }
  },
  {
   "id": "eridu",
   "time": "-232543180800/1",
   "metadata": {
    "title": "Eridu founded",
    "description": "Settled about 5400 BCE, **Eridu** kept a temple rebuilt on the same spot for thousands of years. Sumerian tradition called it the first city, where kingship first came down from heaven.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Eridu"
    ],
    "color": "#a8742a",
    "datePrecision": "Approximate (archaeological dating); placed at the conventional round date."
   }
  },
  {
   "id": "h-uruk",
   "time": "-188363404800/1",
   "metadata": {
    "title": "Uruk: the first cities and writing",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "seals",
   "time": "-172584950400/1",
   "metadata": {
    "title": "Cylinder seals",
    "description": "Small carved stone cylinders, rolled across wet clay to sign or seal goods and documents. They appear in the Uruk period and were used in Mesopotamia for three thousand years.",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Cylinder_seal"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Uruk period, about 3500 BCE."
   }
  },
  {
   "id": "white-temple",
   "time": "-171007113600/1",
   "metadata": {
    "title": "The White Temple at Uruk",
    "description": "A whitewashed temple on a high platform, the **Anu Ziggurat**: a forerunner of the ziggurats.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Anu_ziggurat"
    ],
    "color": "#7a5a2a",
    "datePrecision": "Built about 3500–3000 BCE; placed at 3450."
   }
  },
  {
   "id": "wheel",
   "time": "-169429276800/1",
   "metadata": {
    "title": "Wheeled wagons",
    "description": "Pictographs from the Eanna district of **Uruk** show wagons on wheels. Wheeled vehicles appear at about the same time in the Caucasus and Europe, so where the wheel was first made is unknown.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Wheel"
    ],
    "color": "#2b7a8c",
    "datePrecision": "The Uruk pictographs are dated about 3500–3350 BCE; placed at 3400."
   }
  },
  {
   "id": "writing",
   "time": "-166273603200/1",
   "metadata": {
    "title": "Writing: proto-cuneiform",
    "description": "Clay tablets from **Uruk** record rations, animals and land in signs pressed with a reed. Writing began as bookkeeping; over centuries it became **cuneiform**, used for more than three thousand years.",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Cuneiform",
     "https://en.wikipedia.org/wiki/Proto-cuneiform"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Uruk IV, about 3300 BCE (the earliest unequivocal written documents)."
   }
  },
  {
   "id": "sixty",
   "time": "-163117843200/1",
   "metadata": {
    "title": "Counting in sixties",
    "description": "The earliest accounts already count some goods in a **sexagesimal** (base-60) system, which Babylonian mathematics later wrote with place value. Sixty minutes in an hour and 360 degrees in a circle descend from it.",
    "tags": [
     "science"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Sexagesimal",
     "https://en.wikipedia.org/wiki/Babylonian_cuneiform_numerals"
    ],
    "color": "#2b7a8c",
    "datePrecision": "Proto-cuneiform accounts of the late fourth millennium BCE; placed at 3200."
   }
  },
  {
   "id": "uruk-vase",
   "time": "-159962169600/1",
   "metadata": {
    "title": "The Warka Vase",
    "description": "An alabaster vase from the Eanna temple at **Uruk**, carved in registers: water, crops, animals, and a procession bringing offerings to the goddess **Inanna**.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Warka_Vase"
    ],
    "color": "#7a5a2a",
    "datePrecision": "About 3200–3000 BCE; placed at 3100."
   }
  },
  {
   "id": "uruk-city",
   "time": "-153650822400/1",
   "metadata": {
    "title": "Uruk at its height",
    "description": "**Uruk** covered about 6 square kilometres inside its walls and may have held 50,000 people or more, among the largest cities in the world at the time.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Uruk"
    ],
    "color": "#a8742a",
    "datePrecision": "About 2900 BCE; population estimates vary."
   }
  },
  {
   "id": "h-sumer",
   "time": "-153650822400/1",
   "metadata": {
    "title": "The Sumerian city-states",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "gilgamesh-king",
   "time": "-147339388800/1",
   "metadata": {
    "title": "Gilgamesh, king of Uruk",
    "description": "The **Sumerian King List** names **Gilgamesh** as a king of Uruk. Kings of his time, such as Enmebaragesi of Kish, are attested, so many scholars think he was a real ruler later made a legend.",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Gilgamesh"
    ],
    "color": "#1f3a5f",
    "datePrecision": "If he was historical, about 2700 BCE (Early Dynastic II); no inscription of his own survives."
   }
  },
  {
   "id": "enmebaragesi",
   "time": "-144183715200/1",
   "metadata": {
    "title": "Enmebaragesi of Kish",
    "description": "The earliest Sumerian king whose name appears in inscriptions of his own time. **Kish** gave its name to a title, \"king of Kish\", claimed by later rulers of all Sumer.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Enmebaragesi"
    ],
    "color": "#a8742a",
    "datePrecision": "About 2600 BCE (middle chronology)."
   }
  },
  {
   "id": "royal-cemetery",
   "time": "-142605878400/1",
   "metadata": {
    "title": "The Royal Cemetery of Ur",
    "description": "Tombs at **Ur** full of gold, lapis lazuli and the bodies of attendants buried with their rulers, among them Queen **Puabi**. Excavated by Leonard Woolley in the 1920s.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Royal_Cemetery_at_Ur",
     "https://en.wikipedia.org/wiki/Puabi"
    ],
    "color": "#a8742a",
    "datePrecision": "About 2600–2450 BCE; placed at 2550."
   }
  },
  {
   "id": "standard-of-ur",
   "time": "-141028041600/1",
   "metadata": {
    "title": "The Standard of Ur",
    "description": "An inlaid box from the Royal Cemetery: one side shows war, with wheeled carts drawn by onagers; the other, a banquet and a procession of tribute.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Standard_of_Ur"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 2500 BCE."
   }
  },
  {
   "id": "vultures",
   "time": "-139450204800/1",
   "metadata": {
    "title": "The Stele of the Vultures",
    "description": "**Eannatum** of Lagash celebrates his victory over neighbouring **Umma** in a long border war over fields and water: one of the oldest known war monuments.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Stele_of_the_Vultures"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 2450 BCE."
   }
  },
  {
   "id": "urukagina",
   "time": "-136925596800/1",
   "metadata": {
    "title": "Urukagina's reforms",
    "description": "**Urukagina** of Lagash recorded measures against abuses by officials and the temple, such as cutting the fees charged at burials. Often called the first legal reform, though no code survives.",
    "tags": [
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Urukagina"
    ],
    "color": "#2f6b4f",
    "datePrecision": "Urukagina ruled about 2378–2368 BCE; placed at 2370."
   }
  },
  {
   "id": "lugalzagesi",
   "time": "-136294444800/1",
   "metadata": {
    "title": "Lugalzagesi unites Sumer",
    "description": "**Lugalzagesi** of Umma sacks Lagash and rules the Sumerian cities from Uruk, until **Sargon of Akkad** defeats him.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Lugalzagesi"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 2350 BCE (middle chronology)."
   }
  },
  {
   "id": "h-akkad",
   "time": "-135789523200/1",
   "metadata": {
    "title": "The Akkadian Empire",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "akkad",
   "time": "-135663292800/1",
   "metadata": {
    "title": "Akkad, the lost capital",
    "description": "**Sargon**'s capital, **Akkad** (Agade), gave its name to the empire and to the Akkadian language. Its site has never been found.",
    "tags": [
     "city"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Akkad_(city)"
    ],
    "color": "#a8742a",
    "datePrecision": "Sargon's reign began about 2334 BCE (middle chronology); placed at 2330."
   }
  },
  {
   "id": "enheduanna",
   "time": "-134243308800/1",
   "metadata": {
    "title": "Enheduanna, high priestess at Ur",
    "description": "Sargon's daughter **Enheduanna**, high priestess of the moon god Nanna at Ur. Hymns to Inanna are attributed to her, which would make her the earliest author known by name; the attribution is debated.",
    "tags": [
     "writing"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Enheduanna"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Active about 2300 BCE; placed at 2285."
   }
  },
  {
   "id": "naram-sin-stele",
   "time": "-133138771200/1",
   "metadata": {
    "title": "The Victory Stele of Naram-Sin",
    "description": "**Naram-Sin**, horned like a god, climbs a mountain over the defeated Lullubi. Elamites carried it off to **Susa** a thousand years later, where it was found.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Victory_Stele_of_Naram-Sin"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 2250 BCE (middle chronology)."
   }
  },
  {
   "id": "akkad-falls",
   "time": "-130109328000/1",
   "metadata": {
    "title": "Akkad falls",
    "description": "The empire breaks up amid revolts and the arrival of the **Gutians** from the Zagros; later Mesopotamians told it as a curse on Naram-Sin.",
    "tags": [
     "war"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Akkadian_Empire",
     "https://en.wikipedia.org/wiki/Gutian_dynasty"
    ],
    "color": "#9c3b2a",
    "datePrecision": "About 2154 BCE (middle chronology)."
   }
  },
  {
   "id": "gudea",
   "time": "-129194179200/1",
   "metadata": {
    "title": "The cylinders of Gudea",
    "description": "**Gudea** of Lagash records, on two great clay cylinders, how he rebuilt the temple of Ningirsu: the longest known text in Sumerian. Many of his diorite statues survive.",
    "tags": [
     "writing",
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Gudea",
     "https://en.wikipedia.org/wiki/Gudea_cylinders"
    ],
    "color": "#1f3a5f",
    "datePrecision": "Gudea ruled about 2144–2124 BCE; placed at 2125."
   }
  },
  {
   "id": "h-ur",
   "time": "-128783865600/1",
   "metadata": {
    "title": "The Third Dynasty of Ur",
    "tags": [
     "chapter"
    ],
    "headingLevel": "h2"
   }
  },
  {
   "id": "ziggurat-ur",
   "time": "-128563027200/1",
   "metadata": {
    "title": "The Great Ziggurat of Ur",
    "description": "A stepped temple platform for the moon god **Nanna**, built of mud brick faced with baked brick and bitumen. Its lower stage survives, restored in the 1980s.",
    "tags": [
     "building"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Ziggurat_of_Ur"
    ],
    "color": "#7a5a2a",
    "datePrecision": "Begun under Ur-Nammu (2112–2095 BCE), finished under Shulgi; placed at 2105."
   }
  },
  {
   "id": "ur-nammu-code",
   "time": "-128405260800/1",
   "metadata": {
    "title": "The Code of Ur-Nammu",
    "description": "The oldest law code that survives: **Ur-Nammu** (or his son Shulgi) sets fines in silver for injuries, three centuries before Hammurabi.",
    "tags": [
     "law"
    ],
    "sources": [
     "https://en.wikipedia.org/wiki/Code_of_Ur-Nammu"
    ],
    "color": "#2f6b4f",
