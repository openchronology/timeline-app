   }
  },
  {
   "id": "jerusalem-597",
   "time": "-80969241600/1",
   "metadata": {
    "title": "Nebuchadnezzar takes Jerusalem",
    "description": "A Babylonian chronicle dates it to the day: **Nebuchadnezzar II** takes Jerusalem, deports King **Jehoiachin** to Babylon and sets up Zedekiah.",
    "tags": [
     "war"
    ],
    "sources": [
