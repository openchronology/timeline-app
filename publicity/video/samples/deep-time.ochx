{
 "format": "openchronology",
 "version": 1,
 "title": "Deep time: 4.5 billion years of Earth",
 "description": "Earth's history on one line, from its formation to a single second in 1969. Eons and eras are durations in the colours of the International Chronostratigraphic Chart; times are exact offsets from 2000 CE, shown in millions of years.",
 "presentation": {
  "mode": "float",
  "unit": "million years",
  "scale": "31557600000000/1",
  "origin": "946684800/1",
  "version": 1,
  "offsetMinutes": 0,
  "significantDigits": 5
 },
 "tags": [
  "geology",
  "deep time",
  "science",
  "education"
 ],
 "plugins": [
  {
   "manifest": {
    "apiVersion": 1,
    "id": "rich-text-notes",
    "version": 1,
    "name": "Rich text notes",
    "description": "Edit moment and stack notes visually, storing portable Markdown. Hover cards render safe headings, emphasis, lists, code and HTTPS links. HTML and images are not executed.",
    "fields": [],
    "notes": {
     "kind": "markdown"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-colors",
    "version": 2,
    "name": "Moment colors",
    "description": "Choose muted semantic swatches or a custom color for moments and stack entries while preserving their white borders.",
    "fields": [
     {
      "kind": "color",
      "metadataKey": "color",
      "label": "Moment color"
     }
    ],
    "marker": {
     "kind": "color",
     "metadataKey": "color"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.color(api.get(\"color\")); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "moment-sources",
    "version": 1,
    "name": "Sources",
    "description": "Show and edit a series of source links for moments and stack entries.",
    "fields": [
     {
      "kind": "links",
      "metadataKey": "sources",
      "label": "Sources"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "geological-ages",
    "version": 1,
    "name": "Geological ages",
    "description": "Record an approximate geological age in years before reference year 2000 CE. This annotation does not change the exact coordinate or claim a more precise scientific estimate.",
    "fields": [
     {
      "kind": "text",
      "metadataKey": "approximateAgeYears",
      "label": "Approximate age (years before 2000 CE)"
     }
    ],
    "source": "function render(moment: string, api: PluginAPI): string { return api.none(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "expand-on-hover",
    "version": 1,
    "name": "Expand on hover",
    "description": "Hover or focus a summary of two to five moments to fan out its members radially for individual inspection. Larger summaries stay collapsed.",
    "fields": [],
    "summary": {
     "kind": "radial"
    },
    "source": "function render(moment: string, api: PluginAPI): string { return api.expand(); }"
   },
   "enabled": true
  },
  {
   "manifest": {
    "apiVersion": 1,
    "id": "timeline-theme",
    "version": 1,
    "name": "Timeline theme",
    "description": "Choose the timeline's colors and fonts: its labels, its measure (the axis, tick marks and their times), the halo that keeps them readable over images, the default marker and duration colors, and a background color. Set them here in the plugin list; anything left blank keeps the usual look, and colors chosen for events still win.",
    "fields": [],
    "settings": [
     {
      "kind": "color",
      "key": "textColor",
      "label": "Label color"
     },
     {
      "kind": "font",
      "key": "textFont",
      "label": "Label font"
     },
     {
      "kind": "color",
      "key": "measureColor",
      "label": "Measure color"
     },
     {
      "kind": "font",
      "key": "measureFont",
      "label": "Measure font"
     },
     {
      "kind": "color",
      "key": "haloColor",
      "label": "Halo color"
     },
     {
      "kind": "color",
      "key": "markerColor",
      "label": "Marker color"
     },
     {
      "kind": "color",
      "key": "durationColor",
      "label": "Duration color"
     },
     {
      "kind": "color",
      "key": "backgroundColor",
      "label": "Background color"
     }
    ],
    "theme": {
     "text": "textColor",
     "textFont": "textFont",
     "measure": "measureColor",
     "measureFont": "measureFont",
     "halo": "haloColor",
     "marker": "markerColor",
     "duration": "durationColor",
     "background": "backgroundColor"
    }
   },
   "enabled": true,
   "settings": {
    "textColor": "#e8ecf5",
    "measureColor": "#7cc4e8",
    "haloColor": "#0d1020",
    "markerColor": "#e8ecf5",
    "durationColor": "#3a4a7a",
    "backgroundColor": "#0d1020"
   }
  }
 ],
