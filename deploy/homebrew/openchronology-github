# Receives GitHub webhooks into timelines (github.md) with github.env, until stopped: in a
# terminal, or as your launchd agent with `openchronology-agent start github` (README.Homebrew).
OCH_CONFIG=@HOMEBREW_PREFIX@/etc/openchronology/github.env NODE_ENV=production \
  exec "@NODE@" --import="@LIBEXEC@/server/load-configuration.mjs" "@LIBEXEC@/server/github-receiver.mjs"
