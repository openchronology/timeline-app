# Receives syslog messages into timelines (syslog.md) with syslog.env, until stopped: run it
# under your own launchd agent or terminal session (README.Homebrew).
OCH_CONFIG=@HOMEBREW_PREFIX@/etc/openchronology/syslog.env NODE_ENV=production \
  exec "@NODE@" --import="@LIBEXEC@/server/load-configuration.mjs" "@LIBEXEC@/server/syslog-receiver.mjs"
