# Receives syslog messages into timelines (syslog.md) with syslog.env, until stopped: in a
# terminal, or as your launchd agent with `openchronology-agent start syslog` (README.Homebrew).
OCH_CONFIG=@HOMEBREW_PREFIX@/etc/openchronology/syslog.env NODE_ENV=production \
  exec "@NODE@" --import="@LIBEXEC@/server/load-configuration.mjs" "@LIBEXEC@/server/syslog-receiver.mjs"
