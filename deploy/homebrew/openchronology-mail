# Delivers account email (Resend) with the server's configuration, until stopped: run it under
# your own launchd agent or terminal session (README.Homebrew).
OCH_CONFIG=@HOMEBREW_PREFIX@/etc/openchronology/openchronology.env NODE_ENV=production \
  exec "@NODE@" --import="@LIBEXEC@/server/load-configuration.mjs" "@LIBEXEC@/server/mail-worker.mjs"
