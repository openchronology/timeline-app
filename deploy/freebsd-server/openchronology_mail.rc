#!/bin/sh
# Copyright (c) 2026 Athan Clark. SPDX-License-Identifier: GPL-3.0-only
#
# PROVIDE: openchronology_mail
# REQUIRE: LOGIN postgresql openchronology
# KEYWORD: shutdown
#
# OpenChronology account email delivery (Resend). Enable it in /etc/rc.conf with sysrc openchronology_mail_enable=YES.
# Its configuration is /usr/local/etc/openchronology/openchronology.env (or openchronology_mail_config).

. /etc/rc.subr

name=openchronology_mail
rcvar=openchronology_mail_enable
load_rc_config $name

: ${openchronology_mail_enable:="NO"}
: ${openchronology_mail_config:="/usr/local/etc/openchronology/openchronology.env"}

# daemon(8) runs it as the openchronology user, restarts it if it fails and sends its
# output to syslog.
pidfile="/var/run/openchronology/openchronology_mail.pid"
procname="daemon"
command="/usr/sbin/daemon"
command_args="-r -S -T openchronology_mail -P ${pidfile} -u openchronology /usr/bin/env NODE_ENV=production /usr/local/bin/node --env-file=${openchronology_mail_config} /usr/local/lib/openchronology/server/mail-worker.mjs"
openchronology_mail_chdir="/usr/local/lib/openchronology"
start_precmd="openchronology_mail_prestart"

openchronology_mail_prestart()
{
	install -d -o openchronology -g openchronology -m 0755 /var/run/openchronology
}

run_rc_command "$1"
