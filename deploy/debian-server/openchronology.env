# OpenChronology server configuration: /etc/openchronology/openchronology.env
# Read by the openchronology, openchronology-mail services and openchronology-migrate.
# Restart after editing: sudo systemctl restart openchronology
# Each package version ships its current template as
# /usr/share/openchronology/openchronology.env.example; compare after upgrading.

# The public origin, exactly as users reach it (no trailing slash). Production needs HTTPS:
# put a reverse proxy (nginx, Caddy, Apache) in front of the address below.
APP_ORIGIN=http://localhost:5173
# The server refuses an http:// APP_ORIGIN other than localhost. Set to 1 to allow one on a
# trusted private network (for example http://timeline.lan:5173, with HOST=0.0.0.0): sign-in
# cookies and passwords then cross the network unencrypted.
ALLOW_INSECURE_ORIGIN=0
# Sites that may embed public timelines (/embed/<id>): * for any, or a list of origins.
EMBED_FRAME_ANCESTORS=*
# Where the server listens. Keep it on loopback behind the reverse proxy.
HOST=127.0.0.1
PORT=5173
# Set to 1 only when the reverse proxy overwrites X-Forwarded-For with the one client
# address and the port above is not reachable directly (see README "PostgreSQL deployment").
TRUST_PROXY=0

# The local PostgreSQL database created on first install (peer authentication over the
# Unix socket as the openchronology system user).
DATABASE_URL=postgresql:///openchronology?host=/var/run/postgresql

# 32 random bytes as 64 hex characters, generated on first install. Keep it and back it up
# apart from the database: it encrypts authenticator secrets and signs human checks.
AUTH_ENCRYPTION_KEY=

# Account email through Resend (registration, password reset). Then enable delivery:
#   sudo systemctl enable --now openchronology-mail
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# The first administrator, created by openchronology-migrate when these are set.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Storage per account in bytes (0 = read-only accounts); later changes are made in /admin.
DEFAULT_USER_STORAGE_BYTES=104857600
API_KEY_REQUESTS_PER_MINUTE=120

# Human verification: pow (self-hosted proof of work), turnstile, or off.
CHALLENGE_PROVIDER=pow
CHALLENGE_DIFFICULTY=150000
CHALLENGE_TRUST_DAYS=7
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sign-in providers: leave a pair empty to disable it. Callbacks are documented in
# /usr/share/doc/openchronology-server/authentication.md.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Timeline UUIDs to feature on the dashboard, separated by commas.
FEATURED_TIMELINES=
# A JSON plugin library to offer besides the built-in plugins.
PLUGIN_LIBRARY=
