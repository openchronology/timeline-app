# Purging removes the configuration (including AUTH_ENCRYPTION_KEY) and cached downloads. The
# database is never dropped automatically.
set -e
[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  rm -rf /etc/openchronology /var/lib/openchronology /var/cache/openchronology
  cat <<MSG

The OpenChronology configuration was removed. The PostgreSQL database and the openchronology
system user remain. To delete them as well:

  sudo -u postgres dropdb openchronology
  sudo -u postgres dropuser openchronology
  sudo deluser --system openchronology

MSG
fi
exit 0
