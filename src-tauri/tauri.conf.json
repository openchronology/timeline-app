{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChronology",
  "version": "0.1.0",
  "identifier": "com.openchronology.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build.mjs && node scripts/dev-editor.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenChronology",
        "width": 1400,
        "height": 900,
        "minWidth": 540,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libgmp10", "libsqlite3-0", "libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "gmp", "sqlite-libs"]
      }
    },
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY.md",
      "../dist/THIRD_PARTY.txt",
      "../vendor/sqlite-rational/THIRD_PARTY.md",
      "../vendor/sqlite-rational/LICENSE",
      "../NOTICE",
      "../legal/TERMS.md",
      "../legal/PRIVACY.md",
      "../legal/COPYRIGHT.md",
      "../legal/LAUNCH.md"
    ],
    "license": "GPL-3.0-only",
    "copyright": "Copyright (c) 2026 Athan Clark"
  }
}
