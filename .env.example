# For docker compose. The password is passed directly; no URL encoding required.
POSTGRES_PASSWORD=replace-this-development-password
APP_ORIGIN=http://localhost:5173

# The platform's name in its header, page titles and link previews (such as timescale.info);
# empty shows OpenChronology. At most 60 characters.
PLATFORM_NAME=
# Where visitors can support this platform (GitHub Sponsors, Open Collective, your own page):
# an https:// address. It adds a Support link to the header and footer; empty shows none.
SUPPORT_URL=
# A Google Analytics 4 measurement ID (G-...). Empty disables analytics; when set, visitors
# are asked first, and Google's script loads only for those who accept. See docs/administration.md.
GOOGLE_ANALYTICS_ID=
# The landing page (docs/administration.md#landing-page): 1, true or yes shows a landing page
# at / and pages for each audience at /for/<audience>, and moves the timeline browser to
# /explore (which works either way). Empty or anything else keeps the browser at /.
LANDING_PAGE=
# A directory of Markdown files that replace the landing pages' copy, file by file (home.md,
# audiences.md, educators.md, …; see platform/content/landing/). Empty uses the built-in copy.
LANDING_CONTENT_DIR=
# Example timelines for the landing page, then for each audience's page: owner/slug addresses
# separated by commas, such as athan/deep-time,athan/ancient-egypt. Private, missing and
# labelled timelines are skipped; empty shows the browser's first public timelines, featured
# first.
LANDING_EXAMPLES=
LANDING_EXAMPLES_EDUCATORS=
LANDING_EXAMPLES_RESEARCHERS=
LANDING_EXAMPLES_INVESTIGATORS=
LANDING_EXAMPLES_OPERATIONS=
LANDING_EXAMPLES_WRITERS=
LANDING_EXAMPLES_DEVELOPERS=
# A YouTube video for the landing page, then for each audience's page, such as
# https://www.youtube.com/watch?v=…. It loads from youtube-nocookie.com only when a visitor
# plays it. Empty shows none; an address that is not a YouTube video stops the server starting.
LANDING_VIDEO=
LANDING_VIDEO_EDUCATORS=
LANDING_VIDEO_RESEARCHERS=
LANDING_VIDEO_INVESTIGATORS=
LANDING_VIDEO_OPERATIONS=
LANDING_VIDEO_WRITERS=
LANDING_VIDEO_DEVELOPERS=
# IndexNow (docs/administration.md#indexnow): a key of 8 to 128 letters, digits and dashes,
# such as the output of `openssl rand -hex 16`, served at /<key>.txt. When set, Bing, Yandex and
# other engines are told within minutes which public timelines and profiles changed. Empty is off.
INDEXNOW_KEY=
# Public production origin: https://timescale.info (no trailing slash).
# Enable only if the reverse proxy overwrites X-Forwarded-For with a single client IP
# and the Node port is inaccessible directly. Otherwise leave this at 0.
TRUST_PROXY=0
# Register confidential web apps with the callbacks documented in docs/authentication.md.
# Leave each pair empty to disable that provider. Never put secrets in frontend builds.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
# Set to the Graph API version selected for your Meta app, for example vN.N.
OAUTH_FACEBOOK_GRAPH_VERSION=
# OAUTH_<NAME>_ENABLED=false turns a provider off while keeping its ID and secret, e.g. while its
# app review is pending (OAUTH_GOOGLE_, OAUTH_GITHUB_, OAUTH_FACEBOOK_, OAUTH_MICROSOFT_ENABLED).
OAUTH_FACEBOOK_ENABLED=
# Microsoft (Entra ID / Microsoft 365) work, school or personal accounts.
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# Whose accounts may sign in: organizations (default: any work or school account), common
# (those and personal accounts), consumers (personal accounts only), or one tenant's ID or
# domain (only that school's or organisation's accounts).
OAUTH_MICROSOFT_TENANT=
# The button's name, for example School account; Microsoft if empty.
OAUTH_MICROSOFT_LABEL=

# Passkeys (docs/authentication.md, "Passkeys"): false turns off signing in with a passkey
# alone, leaving passkeys as a second factor only. Empty or true allows it.
PASSKEY_SIGN_IN=

# Directory sign-in (LDAP or Active Directory) for a school or organisation: off unless
# LDAP_URL is set. See docs/authentication.md, "Directory sign-in".
LDAP_URL=
LDAP_STARTTLS=
LDAP_TLS_CA=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_USERNAME_ATTRIBUTE=
LDAP_REQUIRED_GROUP=
LDAP_NESTED_GROUPS=
LDAP_LABEL=

# Comma-separated UUIDs of public timelines to feature first in the dashboard.
# Private timelines remain excluded even when listed here.
FEATURED_TIMELINES=

# Verified sender/domain in Resend. Secrets stay on the server and mail worker.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back up securely; losing/changing it makes enrolled MFA secrets and queued mail unreadable.
AUTH_ENCRYPTION_KEY=

# Optional: existing email-verified account to receive writer access to seed examples.
# Used only by the explicit seed command; no default seed login/password is created.
SEED_MANAGER=

# Initial installation admin. Leave the password empty to disable automatic bootstrap.
# Use a unique random passphrase (15+ characters; any, # included). Used ONCE; never resets an
# existing admin. To set the admin's password to it again: npm run reset-admin-password (or,
# with Compose: docker compose run --rm migrate node server/reset-admin-password.mjs).
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Default storage per account: a byte count or a size such as 500MiB or 2GB (0 = read-only
# accounts). When set, it applies at every start and /admin shows it; unset, the default
# starts at 100 MiB and is changed in /admin. Per-user quotas are always set in /admin.
DEFAULT_USER_STORAGE_BYTES=
# Moments a timeline may hold, and as many durations and relationships: a whole number of
# at least 1000, or unlimited. Empty is 200000. See docs/administration.md before raising it.
TIMELINE_ENTRY_LIMIT=

# Cached downloads (docs/administration.md#cached-downloads): .ochx and .och files kept per
# revision. disk, s3 or off; unset, on (disk) when there is a directory. Give the
# app container a writable volume for EXPORT_CACHE_DIR.
EXPORT_CACHE=
# The disk cache's directory (with s3, where files are staged before upload).
EXPORT_CACHE_DIR=
# The most it holds, such as 10GB; empty is 2GiB. The least recently downloaded go first.
EXPORT_CACHE_MAX_BYTES=
# Optional: a web server or CDN serving the directory or bucket; public timelines' downloads
# redirect there once cached.
EXPORT_CACHE_PUBLIC_URL=
# For EXPORT_CACHE=s3: any S3-compatible service (AWS, R2, Spaces, MinIO…).
EXPORT_CACHE_S3_ENDPOINT=
EXPORT_CACHE_S3_REGION=
EXPORT_CACHE_S3_BUCKET=
EXPORT_CACHE_S3_PREFIX=
EXPORT_CACHE_S3_ACCESS_KEY_ID=
EXPORT_CACHE_S3_SECRET_ACCESS_KEY=
# 1 (default): https://endpoint/bucket/key; 0: https://bucket.endpoint/key.
EXPORT_CACHE_S3_PATH_STYLE=
# How many timelines can be compared at once, from 2 to 8.
COMPARE_TIMELINES_GUEST=4
COMPARE_TIMELINES_USER=8
COMPARE_TIMELINES_ADMIN=8
API_KEY_REQUESTS_PER_MINUTE=120
# Password checks run at once per process (1-64; each about 128 MiB). Empty: one per CPU core,
# at least 2, below UV_THREADPOOL_SIZE (default 4). See docs/authentication.md.
PASSWORD_HASH_CONCURRENCY=

# Human verification for sign-up, emails, repeated sign-in failures, posts to other people's
# timelines by new accounts, and plugin publishing (see docs/authentication.md).
# pow = self-hosted proof of work (default); turnstile = Cloudflare Turnstile; off = none.
CHALLENGE_PROVIDER=pow
# Proof-of-work size: the browser tries up to this many hashes (half on average).
CHALLENGE_DIFFICULTY=150000
# Accounts older than this many days post to other people's timelines without a check.
CHALLENGE_TRUST_DAYS=7
# Optional syslog receiver (docker compose --profile syslog; see docs/syslog.md).
# A read/write API key of an account that can write the routed timelines.
SYSLOG_API_KEY=
# Routing rules (JSON): which messages go to which timeline.
SYSLOG_ROUTES_FILE=./syslog-routes.json
SYSLOG_HOST_PORT=5514
# Required when CHALLENGE_PROVIDER=turnstile; from the Cloudflare Turnstile dashboard.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional immutable identity override for builds from a source archive without Git.
# A normal Docker build detects the checkout commit and exact version tag automatically.
OCH_BUILD_COMMIT=
OCH_BUILD_VERSION=
