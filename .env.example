# For docker compose. The password is passed directly; no URL encoding required.
POSTGRES_PASSWORD=replace-this-development-password
APP_ORIGIN=http://localhost:5173

# Public production origin: https://timescale.info (no trailing slash).
# Enable only if the reverse proxy overwrites X-Forwarded-For with a single client IP
# and the Node port is inaccessible directly. Otherwise leave this at 0.
TRUST_PROXY=0
# Register confidential web apps with the callbacks documented in docs/authentication.md.
# Leave each pair empty to disable that provider. Never put secrets in frontend builds.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
# Set to the Graph API version selected for your Meta app, for example vN.N.
OAUTH_FACEBOOK_GRAPH_VERSION=
